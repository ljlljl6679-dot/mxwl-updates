<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>屿见你 转盘活动</title>
<style>
*{box-sizing:border-box}
:root{--bg0:#090716;--bg1:#160c2f;--bg2:#2a1352;--bg3:#4a237c;--violet:#a96cff;--pink:#e39cff;--ice:#f4ecff;--muted:#d7c9ef;--gold:#ffe8ad;--gold2:#e7bd69}
html,body{margin:0;height:100%}
body{overflow:hidden;font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;color:var(--ice);background:radial-gradient(circle at 18% 18%,rgba(189,121,255,.20),transparent 28%),radial-gradient(circle at 84% 20%,rgba(234,146,255,.16),transparent 24%),radial-gradient(circle at 50% 88%,rgba(110,66,220,.20),transparent 32%),linear-gradient(155deg,var(--bg0),var(--bg1) 36%,var(--bg2) 70%,var(--bg3))}
.page{position:relative;width:100vw;height:100vh;min-height:720px;overflow:hidden;padding:18px}
.nebula,.nebula::before,.nebula::after{content:"";position:absolute;border-radius:50%;filter:blur(50px);pointer-events:none}.nebula{width:34vw;height:18vw;left:7%;top:10%;background:rgba(138,73,255,.14);transform:rotate(-18deg)}.nebula::before{width:18vw;height:10vw;left:36vw;top:6vw;background:rgba(233,138,255,.12)}.nebula::after{width:24vw;height:12vw;left:58vw;top:25vw;background:rgba(108,76,231,.10)}
.starfield{position:absolute;inset:0;pointer-events:none;overflow:hidden}.star{position:absolute;width:2px;height:2px;border-radius:50%;background:#fff;box-shadow:0 0 8px rgba(255,255,255,.95);opacity:.75;animation:twinkle 2.8s ease-in-out infinite}@keyframes twinkle{0%,100%{opacity:.25;transform:scale(.8)}50%{opacity:1;transform:scale(1.6)}}
.shell{position:relative;z-index:2;width:min(96vw,1480px);height:min(92vh,870px);margin:0 auto;padding:18px;display:grid;grid-template-columns:minmax(620px,1.45fr) minmax(360px,.8fr);gap:18px;border-radius:30px;background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.025)),linear-gradient(180deg,rgba(67,35,120,.55),rgba(24,12,52,.72));border:1px solid rgba(255,255,255,.12);box-shadow:0 30px 90px rgba(0,0,0,.34),inset 0 0 0 1px rgba(255,255,255,.04);backdrop-filter:blur(9px)}
.left{position:relative;min-width:0;display:flex;align-items:center;justify-content:center;border-radius:26px;background:radial-gradient(circle at 50% 48%,rgba(190,118,255,.10),transparent 62%);overflow:hidden}.left::before{content:"";position:absolute;inset:6%;border-radius:50%;background:conic-gradient(from 0deg,transparent,rgba(255,255,255,.05),transparent 12%,transparent 35%,rgba(227,156,255,.08),transparent 52%,transparent 72%,rgba(255,255,255,.05),transparent);animation:slowSpin 18s linear infinite}@keyframes slowSpin{to{transform:rotate(360deg)}}
.wheel-wrap{position:relative;width:min(53vw,690px);aspect-ratio:1;display:grid;place-items:center}.outer-glow{position:absolute;inset:4.5%;border-radius:50%;box-shadow:0 0 0 2px rgba(255,255,255,.18),0 0 0 8px rgba(171,113,255,.08),0 0 32px rgba(186,123,255,.28),0 0 80px rgba(128,73,219,.18)}.ornament-ring{position:absolute;inset:2.8%;border-radius:50%;border:1px solid rgba(255,255,255,.22);box-shadow:inset 0 0 18px rgba(255,255,255,.07);pointer-events:none}.ornament-ring::before,.ornament-ring::after{content:"✦";position:absolute;left:50%;transform:translateX(-50%);color:var(--gold);font-size:28px;text-shadow:0 0 18px rgba(255,232,173,.55)}.ornament-ring::before{top:-18px}.ornament-ring::after{bottom:-18px}.side-orn{position:absolute;top:50%;font-size:24px;color:var(--gold);text-shadow:0 0 16px rgba(255,232,173,.55);z-index:5}.side-orn.l{left:1.7%;transform:translateY(-50%)}.side-orn.r{right:1.7%;transform:translateY(-50%)}
.pointer{position:absolute;z-index:20;left:50%;top:1.6%;transform:translateX(-50%);width:0;height:0;border-left:24px solid transparent;border-right:24px solid transparent;border-bottom:46px solid #fff7df;filter:drop-shadow(0 5px 10px rgba(0,0,0,.28)) drop-shadow(0 0 12px rgba(255,232,173,.35))}.pointer::after{content:"";position:absolute;left:-8px;top:8px;width:16px;height:16px;border-radius:50%;background:linear-gradient(180deg,var(--gold),var(--gold2));box-shadow:0 0 0 5px rgba(255,255,255,.16),0 0 18px rgba(255,232,173,.48)}
.wheel{position:absolute;inset:7.5%;border-radius:50%;overflow:hidden;border:12px solid rgba(255,255,255,.19);background:conic-gradient(from -20deg,#8a52db 0 40deg,#6d39bd 40deg 80deg,#995fe6 80deg 120deg,#783fc8 120deg 160deg,#8f55dc 160deg 200deg,#6734b6 200deg 240deg,#9b61e8 240deg 280deg,#7440c3 280deg 320deg,#8950d7 320deg 360deg);box-shadow:0 22px 48px rgba(0,0,0,.28),inset 0 0 0 5px rgba(255,255,255,.06),inset 0 0 34px rgba(255,255,255,.10);transition:transform 5.25s cubic-bezier(.10,.72,.12,1);will-change:transform}.wheel::before{content:"";position:absolute;inset:0;border-radius:50%;background:repeating-conic-gradient(from -20deg,rgba(255,255,255,.82) 0 .7deg,transparent .7deg 40deg);-webkit-mask:radial-gradient(circle,transparent 0 18%,#000 18.4% 100%);mask:radial-gradient(circle,transparent 0 18%,#000 18.4% 100%);pointer-events:none}.wheel::after{content:"";position:absolute;inset:9.5%;border-radius:50%;border:1px solid rgba(255,255,255,.13);pointer-events:none}
.prize{position:absolute;left:50%;top:50%;width:128px;height:136px;transform-origin:center center;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;color:#fff;pointer-events:none;filter:drop-shadow(0 2px 6px rgba(22,9,50,.55))}.prize.long{width:142px;height:142px}.prize-icon{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;font-size:24px;font-weight:900;color:#fffaf0;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.26),rgba(232,156,255,.18) 45%,rgba(103,49,188,.08));border:1px solid rgba(255,255,255,.16);box-shadow:0 0 18px rgba(226,151,255,.22),inset 0 0 10px rgba(255,255,255,.08)}.prize-text{margin-top:7px;max-width:136px;font-size:15px;font-weight:900;line-height:1.12;letter-spacing:.01em;text-shadow:0 2px 4px rgba(22,9,50,.72),0 0 10px rgba(255,255,255,.10);word-break:keep-all}.prize.long .prize-text{font-size:13px;max-width:142px}
.center-ring{position:absolute;z-index:11;left:50%;top:50%;transform:translate(-50%,-50%);width:190px;height:190px;border-radius:50%;border:1px dashed rgba(255,255,255,.18);pointer-events:none}.center-btn{position:absolute;z-index:21;left:50%;top:50%;transform:translate(-50%,-50%);width:156px;height:156px;border-radius:50%;border:9px solid rgba(255,255,255,.22);background:radial-gradient(circle at 35% 30%,#fff7dd 0%,#f5d37b 38%,#bc8524 100%);color:#5b3600;font-size:28px;font-weight:900;letter-spacing:.05em;line-height:1.1;box-shadow:0 14px 26px rgba(0,0,0,.26),inset 0 0 18px rgba(255,255,255,.45),0 0 30px rgba(255,232,173,.18);cursor:pointer}.center-btn small{display:block;font-size:17px;margin-top:5px}.center-btn:hover{filter:brightness(1.04)}.center-btn:disabled{cursor:default;opacity:.92}
.right{min-width:0;position:relative;display:flex;align-items:center;justify-content:center;padding:16px}.right-inner{width:min(100%,520px);display:flex;flex-direction:column;align-items:center;gap:16px}.eyebrow{padding:7px 15px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.10);color:#eadcff;font-size:13px;font-weight:800;letter-spacing:.12em}.brand{margin:0;text-align:center;font-size:clamp(46px,4.8vw,82px);font-weight:900;line-height:.98;letter-spacing:.03em;background:linear-gradient(180deg,#ffffff 0%,#f6eaff 36%,#d7baff 72%,#ffffff 100%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 24px rgba(220,167,255,.20)}.brand-sub{margin-top:-3px;color:#dbc9f5;font-size:clamp(14px,1.15vw,18px);letter-spacing:.28em;text-align:center}.divider{width:76%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.66),transparent)}
.rules{width:100%;padding:22px 24px;border-radius:24px;background:linear-gradient(180deg,rgba(255,255,255,.10),rgba(255,255,255,.04)),linear-gradient(180deg,rgba(55,26,105,.64),rgba(25,12,56,.72));border:1px solid rgba(255,255,255,.13);box-shadow:0 18px 38px rgba(0,0,0,.18),inset 0 0 0 1px rgba(255,255,255,.03)}.rules h2{margin:0 0 14px;text-align:center;font-size:25px;letter-spacing:.10em}.rule{display:flex;align-items:center;gap:12px;padding:12px;border-radius:15px;background:rgba(255,255,255,.045);margin-top:9px;color:#efe8fa;font-weight:800;font-size:16px}.num{flex:0 0 auto;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(180deg,var(--gold),var(--gold2));color:#5a3600;font-weight:900}.status{width:100%;padding:12px 14px;border-radius:16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);color:#e7dbf8;text-align:center;font-size:14px;font-weight:700}.foot{font-size:13px;color:#cbb9e3;letter-spacing:.08em;text-align:center}
.modal{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;padding:16px;background:rgba(9,5,22,.58);backdrop-filter:blur(5px)}.modal.show{display:flex}.popup{width:min(92vw,430px);padding:26px 24px 20px;border-radius:24px;text-align:center;background:linear-gradient(180deg,rgba(255,255,255,.12),rgba(255,255,255,.04)),linear-gradient(180deg,rgba(74,36,134,.98),rgba(30,13,67,.98));border:1px solid rgba(255,255,255,.13);box-shadow:0 28px 80px rgba(0,0,0,.34);animation:pop .28s ease-out}@keyframes pop{from{transform:scale(.90);opacity:.15}to{transform:scale(1);opacity:1}}.burst{font-size:36px;margin-bottom:5px}.popup h3{margin:0 0 10px;font-size:27px}.win-prize{display:inline-flex;align-items:center;justify-content:center;min-width:230px;min-height:58px;padding:12px 18px;border-radius:17px;background:linear-gradient(180deg,#fff6d8,#edc86d);color:#603a00;font-size:23px;font-weight:900;margin-bottom:14px}.popup p{margin:0 0 18px;color:#ded0f1}.actions{display:flex;gap:10px;justify-content:center}.actions button{border:0;border-radius:999px;padding:11px 21px;font-size:15px;font-weight:900;cursor:pointer}.close{background:rgba(255,255,255,.10);color:#fff}.again{background:linear-gradient(180deg,var(--gold),var(--gold2));color:#5c3700}
.confetti{position:fixed;z-index:120;width:8px;height:14px;border-radius:2px;pointer-events:none;animation:fall 1.25s ease-out forwards}@keyframes fall{0%{transform:translate(0,0) rotate(0deg);opacity:1}100%{transform:translate(var(--dx),var(--dy)) rotate(var(--rot));opacity:0}}
@media (max-width:1050px){body{overflow:auto}.page{height:auto;min-height:100vh}.shell{height:auto;grid-template-columns:1fr}.left{min-height:650px}.wheel-wrap{width:min(90vw,650px)}}
@media (max-width:700px){.page{padding:8px}.shell{padding:10px;border-radius:22px}.left{min-height:530px}.wheel-wrap{width:min(96vw,520px)}.pointer{border-left-width:16px;border-right-width:16px;border-bottom-width:30px}.pointer::after{left:-5px;top:6px;width:10px;height:10px;box-shadow:0 0 0 3px rgba(255,255,255,.14)}.prize{width:90px;height:96px}.prize.long{width:98px;height:100px}.prize-icon{width:32px;height:32px;font-size:17px}.prize-text{margin-top:4px;font-size:10px;max-width:88px}.prize.long .prize-text{font-size:9px;max-width:96px}.center-ring{width:145px;height:145px}.center-btn{width:116px;height:116px;font-size:21px;border-width:6px}.center-btn small{font-size:13px}.right{padding:8px}.brand{font-size:48px}.rules{padding:16px}.rule{font-size:14px}}
</style>
</head>
<body>
<div class="page">
  <div class="nebula"></div><div class="starfield" id="starfield"></div>
  <div class="shell">
    <section class="left">
      <div class="wheel-wrap">
        <div class="outer-glow"></div><div class="ornament-ring"></div><div class="side-orn l">✦</div><div class="side-orn r">✦</div>
        <div class="pointer" aria-hidden="true"></div><div class="wheel" id="wheel"></div><div class="center-ring"></div>
        <button class="center-btn" id="spinBtn" type="button">开启转盘<small>开始</small></button>
      </div>
    </section>
    <aside class="right">
      <div class="right-inner">
        <div class="eyebrow">ISLAND OF MELODY · LIVE EVENT</div>
        <h1 class="brand">屿见你<br>转盘活动</h1>
        <div class="brand-sub">梦 幻 紫 夜 ✦ 幸 运 开 启</div><div class="divider"></div>
        <div class="rules"><h2>玩法介绍</h2><div class="rule"><span class="num">1</span><span>首次轮盘：99</span></div><div class="rule"><span class="num">2</span><span>二次及以后：299</span></div><div class="rule"><span class="num">3</span><span>点击中间“开启转盘”即可开始抽奖</span></div></div>
        <div class="status" id="status">准备就绪，点击“开启转盘”开始抽奖</div><div class="foot">屿见你 · 幸运转盘活动</div>
      </div>
    </aside>
  </div>
</div>
<div class="modal" id="modal" aria-live="polite"><div class="popup"><div class="burst">✨💜✨</div><h3>恭喜抽中</h3><div class="win-prize" id="winPrize">半首歌</div><p id="winText">好运已经为你揭晓。</p><div class="actions"><button type="button" class="close" id="closeBtn">关闭</button><button type="button" class="again" id="againBtn">再转一次</button></div></div></div>
<script>
(() => {
  const wheel=document.getElementById('wheel'),spinBtn=document.getElementById('spinBtn'),status=document.getElementById('status'),modal=document.getElementById('modal'),winPrize=document.getElementById('winPrize'),winText=document.getElementById('winText'),closeBtn=document.getElementById('closeBtn'),againBtn=document.getElementById('againBtn'),starfield=document.getElementById('starfield');
  const prizes=[
    {name:'点歌卡',weight:10,icon:'♫',msg:'恭喜获得点歌卡，今晚的幸运歌单由你开启。'},
    {name:'冠歌续期卡',weight:1,icon:'♛',msg:'恭喜获得冠歌续期卡，专属权益继续延长。'},
    {name:'半首歌',weight:15,icon:'♪',msg:'恭喜获得半首歌，送你一段专属演唱。'},
    {name:'抽象歌单',weight:15,icon:'✦',msg:'恭喜获得抽象歌单，解锁一份特别歌单。'},
    {name:'音频卡',weight:10,icon:'◉',msg:'恭喜获得音频卡，可兑换指定音频福利。'},
    {name:'强开火车（需补299）',weight:1,icon:'♜',msg:'恭喜抽中强开火车（需补299），请按活动规则执行。'},
    {name:'谢谢参与',weight:22,icon:'☆',msg:'感谢参与，下一次也许就是大奖。'},
    {name:'表白卡',weight:22,icon:'♡',msg:'恭喜获得表白卡，浪漫表达由你指定。'},
    {name:'大冒险（需补199）',weight:4,icon:'⚑',msg:'恭喜抽中大冒险（需补199），准备接受挑战吧。'}
  ];
  const pretty={'冠歌续期卡':'冠歌<br>续期卡','强开火车（需补299）':'强开火车<br>（需补299）','大冒险（需补199）':'大冒险<br>（需补199）'};
  const step=360/prizes.length,totalWeight=prizes.reduce((s,p)=>s+p.weight,0),radius=window.innerWidth<=700?118:184;
  prizes.forEach((p,i)=>{const angle=i*step,el=document.createElement('div');el.className='prize'+(p.name.length>=7?' long':'');el.innerHTML=`<span class="prize-icon">${p.icon}</span><span class="prize-text">${pretty[p.name]||p.name}</span>`;el.style.transform=`translate(-50%,-50%) rotate(${angle}deg) translateY(-${radius}px)`;wheel.appendChild(el)});
  for(let i=0;i<95;i++){const s=document.createElement('i');s.className='star';s.style.left=(Math.random()*100)+'%';s.style.top=(Math.random()*100)+'%';const z=1+Math.random()*2.2;s.style.width=z+'px';s.style.height=z+'px';s.style.animationDelay=(Math.random()*2.8)+'s';s.style.animationDuration=(2+Math.random()*3.2)+'s';starfield.appendChild(s)}
  let rotation=0,spinning=false,audioCtx=null;
  function secureRandom01(){if(window.crypto&&crypto.getRandomValues){const a=new Uint32Array(1);crypto.getRandomValues(a);return a[0]/4294967296}return Math.random()}
  function pickIndex(){let r=secureRandom01()*totalWeight;for(let i=0;i<prizes.length;i++){r-=prizes[i].weight;if(r<0)return i}return prizes.length-1}
  function norm(d){return((d%360)+360)%360}
  function ensureAudio(){try{if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();if(audioCtx.state==='suspended')audioCtx.resume();return true}catch(e){return false}}
  function spinSound(){if(!ensureAudio())return;const now=audioCtx.currentTime,o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='triangle';o.frequency.setValueAtTime(180,now);o.frequency.exponentialRampToValueAtTime(620,now+.65);g.gain.setValueAtTime(.0001,now);g.gain.exponentialRampToValueAtTime(.03,now+.04);g.gain.exponentialRampToValueAtTime(.0001,now+.68);o.connect(g).connect(audioCtx.destination);o.start(now);o.stop(now+.7);for(let i=0;i<15;i++){const t=now+.16+i*.10,a=audioCtx.createOscillator(),b=audioCtx.createGain();a.type='square';a.frequency.setValueAtTime(980-i*30,t);b.gain.setValueAtTime(.0001,t);b.gain.exponentialRampToValueAtTime(.014,t+.003);b.gain.exponentialRampToValueAtTime(.0001,t+.035);a.connect(b).connect(audioCtx.destination);a.start(t);a.stop(t+.04)}}
  function winSound(){if(!ensureAudio())return;const now=audioCtx.currentTime;[659.25,783.99,987.77,1318.5].forEach((f,i)=>{const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.setValueAtTime(f,now+i*.07);g.gain.setValueAtTime(.0001,now+i*.07);g.gain.exponentialRampToValueAtTime(.045,now+i*.07+.02);g.gain.exponentialRampToValueAtTime(.0001,now+i*.07+.26);o.connect(g).connect(audioCtx.destination);o.start(now+i*.07);o.stop(now+i*.07+.28)})}
  function confetti(){const palette=['#ffe8ad','#dca1ff','#9d73ff','#ffffff','#f5c6ff'];for(let i=0;i<36;i++){const c=document.createElement('span');c.className='confetti';c.style.left='50%';c.style.top='50%';c.style.background=palette[i%palette.length];c.style.setProperty('--dx',(Math.random()*520-260)+'px');c.style.setProperty('--dy',(Math.random()*360-100)+'px');c.style.setProperty('--rot',(Math.random()*720-360)+'deg');c.style.animationDelay=(Math.random()*.12)+'s';document.body.appendChild(c);setTimeout(()=>c.remove(),1500)}}
  function showWin(p){winPrize.textContent=p.name;winText.textContent=p.msg;modal.classList.add('show');confetti()}
  function spin(){if(spinning)return;modal.classList.remove('show');spinning=true;spinBtn.disabled=true;status.textContent='转盘旋转中，请稍候…';spinSound();const index=pickIndex(),centerAngle=index*step,targetNorm=norm(-centerAngle),currentNorm=norm(rotation),correction=norm(targetNorm-currentNorm),turns=6+Math.floor(secureRandom01()*3);rotation+=turns*360+correction;wheel.style.transform=`rotate(${rotation}deg)`;setTimeout(()=>{spinning=false;spinBtn.disabled=false;const p=prizes[index];status.textContent=`恭喜抽中：${p.name}`;winSound();showWin(p)},5350)}
  spinBtn.addEventListener('click',spin);againBtn.addEventListener('click',spin);closeBtn.addEventListener('click',()=>modal.classList.remove('show'));modal.addEventListener('click',e=>{if(e.target===modal)modal.classList.remove('show')});
})();
</script>
</body>
</html>
