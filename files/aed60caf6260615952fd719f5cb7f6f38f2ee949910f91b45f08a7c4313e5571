<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>梦露转盘活动</title>
<style>
:root{--bg:#030206;--pink:#ff2f8c;--pink2:#ff66b2;--light:#ffd6eb;--dark:#110813;}
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0;background:#000;font-family:"Microsoft YaHei","PingFang SC",sans-serif;overflow:hidden;color:#fff}
body{display:grid;place-items:center;user-select:none;-webkit-user-select:none}
button{font:inherit}
.stage{position:relative;width:min(100vw,177.777vh);aspect-ratio:16/9;height:auto;max-height:100vh;overflow:hidden;background:#000}
.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block;pointer-events:none;user-select:none}
.wheel-wrap{position:absolute;left:5.126953%;top:4.687500%;width:51.855469%;aspect-ratio:1/1;filter:drop-shadow(0 0 8px rgba(255,40,139,.16));pointer-events:none;}
.wheel-disc{position:absolute;inset:0;transform-origin:50% 50%;will-change:transform}
.wheel-disc img{display:block;width:100%;height:100%;object-fit:contain}
.wheel-wrap.spinning{animation:stageGlow .42s ease-in-out infinite alternate}
@keyframes stageGlow{from{filter:drop-shadow(0 0 12px rgba(255,50,148,.45)) drop-shadow(0 0 26px rgba(255,0,122,.28))}to{filter:drop-shadow(0 0 20px rgba(255,130,190,.8)) drop-shadow(0 0 45px rgba(255,0,122,.55))}}
.static-pointer{position:absolute;left:29.003906%;top:3.645833%;width:4.101562%;pointer-events:none;z-index:4;}
.center-hit{position:absolute;left:25.805664%;top:41.449653%;width:10.498047%;aspect-ratio:1/1;border-radius:50%;background:transparent;border:none;cursor:pointer;z-index:5}
.center-hit:disabled{cursor:default}
.center-hit:focus-visible{outline:2px solid rgba(255,255,255,.7);outline-offset:4px}
.center-hit::after{content:"";position:absolute;inset:-1.2%;border-radius:50%;box-shadow:0 0 0 0 rgba(255,255,255,0);transition:.18s}
.center-hit:hover::after{box-shadow:0 0 0 3px rgba(255,255,255,.16),0 0 18px rgba(255,81,167,.42)}
.center-hit:active{transform:scale(.985)}
.fx-layer{position:absolute;inset:0;pointer-events:none}
.hint{position:absolute;left:50%;bottom:2%;transform:translateX(-50%);padding:.4em .95em;border-radius:999px;background:rgba(7,4,12,.56);border:1px solid rgba(255,101,177,.28);font-size:clamp(10px,.85vw,14px);color:rgba(255,230,242,.82);letter-spacing:.08em;backdrop-filter:blur(4px)}
.overlay{position:absolute;inset:0;background:rgba(3,0,8,.72);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease;z-index:20;backdrop-filter:blur(6px)}
.overlay.show{opacity:1;pointer-events:auto}
.card{position:relative;width:min(430px,86vw);padding:28px 24px 22px;border-radius:26px;border:1.6px solid rgba(255,154,212,.78);background:linear-gradient(180deg,rgba(44,11,34,.95),rgba(16,7,24,.96));box-shadow:0 0 0 1px rgba(255,214,236,.18) inset,0 0 24px rgba(255,57,149,.25),0 14px 45px rgba(0,0,0,.45);text-align:center}
.card::before,.card::after{content:"✦";position:absolute;color:#ffd7eb;text-shadow:0 0 10px #ff3797;top:-12px;font-size:26px}
.card::before{left:18px} .card::after{right:18px}
.win-title{font-size:34px;font-weight:900;letter-spacing:.12em;margin:2px 0 8px;text-shadow:0 0 12px rgba(255,78,169,.55)}
.win-sub{font-size:15px;color:#ffbdda;letter-spacing:.25em;margin-bottom:14px}
.win-icon{width:138px;height:138px;margin:0 auto 10px;display:grid;place-items:center;border-radius:22px;background:radial-gradient(circle at 50% 36%,rgba(255,143,195,.18),rgba(255,54,136,.06) 60%,rgba(255,54,136,0));border:1px solid rgba(255,140,208,.2);box-shadow:inset 0 0 20px rgba(255,72,151,.08)}
.win-icon img{max-width:100%;max-height:100%;object-fit:contain;filter:drop-shadow(0 4px 12px rgba(255,42,136,.28))}
.win-name{font-size:40px;font-weight:900;letter-spacing:.04em;margin:8px 0 4px;text-shadow:0 0 14px rgba(255,86,172,.42)}
.win-price{font-size:26px;font-weight:800;color:#ffe6f3;margin-bottom:18px}
.win-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.action{min-width:138px;border:none;border-radius:999px;padding:12px 18px;font-weight:800;letter-spacing:.08em;cursor:pointer}
.action.primary{background:linear-gradient(180deg,#ff86c8,#ff2f8c 56%,#ba0f5b);color:#fff;box-shadow:0 4px 20px rgba(255,36,133,.36)}
.action.secondary{background:rgba(255,255,255,.08);color:#ffe8f4;border:1px solid rgba(255,169,217,.35)}
.controls{position:absolute;right:1.4%;top:2.2%;display:flex;gap:10px;z-index:8}
.ctrl{border:none;border-radius:999px;padding:8px 12px;background:rgba(11,7,18,.45);color:rgba(255,228,240,.82);backdrop-filter:blur(4px);border:1px solid rgba(255,110,183,.22);font-size:12px;cursor:pointer}
.controls{opacity:0;transition:opacity .22s;}
.controls:hover,.controls:focus-within{opacity:1;}
.ctrl:hover{background:rgba(29,12,34,.66);color:#fff}
.notice{position:absolute;right:1.8%;bottom:2.1%;font-size:11px;letter-spacing:.08em;color:rgba(255,190,223,.46)}
@media (max-width:800px){
  .controls{top:auto;bottom:1.7%;right:1.5%}
  .hint{display:none}
  .card{width:min(390px,90vw)}
  .win-name{font-size:32px}
}
</style>
</head>
<body>
<div class="stage" id="stage">
  <img class="bg" src="data:image/png;base64," alt="梦露转盘活动背景">
  <div class="wheel-wrap" id="wheelWrap">
    <div class="wheel-disc" id="wheelDisc"><img src="data:image/png;base64," alt="互动转盘"></div>
  </div>
  <img class="static-pointer" src="data:image/png;base64," aria-hidden="true">
  <button id="spinBtn" class="center-hit" aria-label="点击开启转盘抽奖"></button>
  <canvas id="fx" class="fx-layer"></canvas>
  <div class="controls">
    <button id="soundBtn" class="ctrl" type="button">音效：开</button>
    <button id="fullBtn" class="ctrl" type="button">全屏</button>
  </div>


  <div id="overlay" class="overlay" aria-hidden="true">
    <div class="card">
      <div class="win-title">恭喜中奖</div>
      <div class="win-sub">LUCKY MOMENT</div>
      <div class="win-icon"><img id="winIcon" alt="中奖礼物"></div>
      <div id="winName" class="win-name">礼物名称</div>
      <div id="winPrice" class="win-price">0 钻</div>
      <div class="win-actions">
        <button id="againBtn" class="action primary" type="button">再抽一次</button>
        <button id="closeBtn" class="action secondary" type="button">关闭</button>
      </div>
    </div>
  </div>
</div>
<script>
(()=>{
'use strict';
const PRIZES=[{"name": "真爱玫瑰", "price": 366, "weight": 19.5, "icon": "data:image/png;base64,"}, {"name": "礼花筒", "price": 199, "weight": 19.5, "icon": "data:image/png;base64,"}, {"name": "真的爱你", "price": 520, "weight": 19.5, "icon": "data:image/png;base64,"}, {"name": "浪漫花火", "price": 599, "weight": 19.5, "icon": "data:image/png;base64,"}, {"name": "掌上明珠", "price": 888, "weight": 1.0, "icon": "data:image/png;base64,"}, {"name": "比心兔兔", "price": 299, "weight": 19.5, "icon": "data:image/png;base64,"}, {"name": "跑车", "price": 1200, "weight": 0.5, "icon": "data:image/png;base64,"}, {"name": "闪耀星辰", "price": 99, "weight": 1.0, "icon": "data:image/png;base64,"}];
const CENTERS=[22.5,67.5,112.5,157.5,202.5,247.5,292.5,337.5];
const disc=document.getElementById('wheelDisc');
const wheelWrap=document.getElementById('wheelWrap');
const spinBtn=document.getElementById('spinBtn');
const soundBtn=document.getElementById('soundBtn');
const fullBtn=document.getElementById('fullBtn');
const overlay=document.getElementById('overlay');
const againBtn=document.getElementById('againBtn');
const closeBtn=document.getElementById('closeBtn');
const winIcon=document.getElementById('winIcon');
const winName=document.getElementById('winName');
const winPrice=document.getElementById('winPrice');
const stage=document.getElementById('stage');
const fx=document.getElementById('fx');
const fctx=fx.getContext('2d');
let rotation=0, spinning=false, soundOn=true, audioCtx=null, tickInterval=null, particles=[], runID=0;

function resizeCanvas(){
  const rect=stage.getBoundingClientRect();
  fx.width=Math.round(rect.width*devicePixelRatio); fx.height=Math.round(rect.height*devicePixelRatio);
  fx.style.width=rect.width+'px'; fx.style.height=rect.height+'px';
  fctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
}
window.addEventListener('resize',resizeCanvas); resizeCanvas();

function rnd(min,max){return Math.random()*(max-min)+min}
function choosePrize(){
  const total=PRIZES.reduce((s,p)=>s+p.weight,0);
  let r=Math.random()*total;
  for(let i=0;i<PRIZES.length;i++){r-=PRIZES[i].weight;if(r<=0) return i;}
  return PRIZES.length-1;
}
function ensureAudio(){ if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)(); }
function tone(freq,duration=.08,type='triangle',gain=.03,when=0){
  if(!soundOn) return; ensureAudio(); const t=audioCtx.currentTime+when;
  const o=audioCtx.createOscillator(), g=audioCtx.createGain(); o.type=type; o.frequency.value=freq; g.gain.value=0;
  o.connect(g); g.connect(audioCtx.destination); g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(gain,t+.01); g.gain.exponentialRampToValueAtTime(0.0001,t+duration); o.start(t); o.stop(t+duration+.02);
}
function playTick(){ tone(980,.05,'square',.018); }
function playWin(){ tone(784,.12,'triangle',.04,0); tone(988,.14,'triangle',.04,.10); tone(1319,.18,'triangle',.05,.24); }
function startTickLoop(){ if(!soundOn) return; clearInterval(tickInterval); tickInterval=setInterval(playTick,95); }
function stopTickLoop(){ clearInterval(tickInterval); tickInterval=null; }

function setSound(v){ soundOn=v; soundBtn.textContent='音效：'+(v?'开':'关'); }
setSound(true);
soundBtn.addEventListener('click',()=>setSound(!soundOn));
fullBtn.addEventListener('click',()=>{ if(document.fullscreenElement) document.exitFullscreen(); else stage.requestFullscreen?.(); });
document.addEventListener('dblclick',()=>{ if(!document.fullscreenElement) stage.requestFullscreen?.(); });

document.addEventListener('keydown',e=>{ if((e.key==='Enter'||e.key===' ')&&!spinning&&!overlay.classList.contains('show')){e.preventDefault(); spin();} if(e.key.toLowerCase()==='f'){ if(!document.fullscreenElement) stage.requestFullscreen?.(); else document.exitFullscreen?.(); } if(e.key==='Escape'&&overlay.classList.contains('show')) closeOverlay(); });

function spawnBurst(count=110){
  const rect=stage.getBoundingClientRect();
  const x=rect.width*0.5, y=rect.height*0.46;
  for(let i=0;i<count;i++){
    particles.push({x,y,vx:rnd(-4.8,4.8),vy:rnd(-7,-1.5),g:rnd(.09,.17),size:rnd(2,5.2),life:rnd(38,62),h:Math.random()<.5?'#ff4fa5':'#ffd4ea'});
  }
}
function drawParticles(){
  const rect=stage.getBoundingClientRect();
  fctx.clearRect(0,0,rect.width,rect.height);
  particles=particles.filter(p=>p.life>0);
  for(const p of particles){
    p.x+=p.vx; p.y+=p.vy; p.vy+=p.g; p.life-=1; p.vx*=.993;
    fctx.globalAlpha=Math.max(0,p.life/60);
    fctx.fillStyle=p.h; fctx.shadowColor=p.h; fctx.shadowBlur=10;
    fctx.beginPath(); fctx.arc(p.x,p.y,p.size,0,Math.PI*2); fctx.fill();
  }
  fctx.globalAlpha=1; fctx.shadowBlur=0;
  if(particles.length) requestAnimationFrame(drawParticles);
}
function celebrate(){ spawnBurst(120); requestAnimationFrame(drawParticles); }

function showOverlay(prize){
  winIcon.src=prize.icon; winName.textContent=prize.name; winPrice.textContent=prize.price+' 钻';
  overlay.classList.add('show'); overlay.setAttribute('aria-hidden','false');
  celebrate(); playWin();
}
function closeOverlay(){ overlay.classList.remove('show'); overlay.setAttribute('aria-hidden','true'); }
closeBtn.addEventListener('click',closeOverlay);
overlay.addEventListener('click',e=>{ if(e.target===overlay) closeOverlay(); });
againBtn.addEventListener('click',()=>{ closeOverlay(); setTimeout(spin,220); });

function spin(){
  if(spinning) return;
  if(soundOn) { ensureAudio(); if(audioCtx.state==='suspended') audioCtx.resume(); }
  closeOverlay();
  spinning=true; spinBtn.disabled=true; wheelWrap.classList.add('spinning');
  const thisRun=++runID;
  const index=choosePrize(); const prize=PRIZES[index];
  const current=((rotation%360)+360)%360;
  const desired=(360-CENTERS[index])%360;
  const offset=(desired-current+360)%360;
  const extra=(7+Math.floor(Math.random()*3))*360;
  rotation += extra + offset;
  const duration=6400 + Math.random()*500;
  disc.style.transition=`transform ${duration}ms cubic-bezier(.12,.68,.09,1)`;
  requestAnimationFrame(()=>disc.style.transform=`rotate(${rotation}deg)`);
  startTickLoop();
  const end=()=>{
    if(thisRun!==runID || !spinning) return;
    disc.removeEventListener('transitionend',end); stopTickLoop(); spinning=false; spinBtn.disabled=false; wheelWrap.classList.remove('spinning'); showOverlay(prize);
  };
  disc.addEventListener('transitionend',end,{once:true});
  setTimeout(end,duration+350);
}
spinBtn.addEventListener('click',spin);
})();
</script>
</body>
</html>