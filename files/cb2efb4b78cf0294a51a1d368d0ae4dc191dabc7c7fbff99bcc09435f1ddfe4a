 $('waiting').classList.add('hidden');renderBoard();renderPlayers();renderDistricts();const p=state.players[state.current];$('currentDot').style.background=colors[p.id%colors.length];$('currentName').textContent=p.name;$('roundNum').textContent=state.round;$('turnNum').textContent=state.turn;$('lotNum').textContent=Object.keys(state.ownership).length;$('centerProperties').textContent=`🏠 已售 ${Object.keys(state.ownership).length} / 24 · 集齐街区租金 ×1.5`;$('gameHint').innerHTML=state.stage==='rolling'?'🎲 骰子转动中，星光冒险即将开始…':state.stage==='ready'?'✨ 等待主持人掷骰 · 祝你好运':`🎯 本次前进 <strong>${state.lastRoll||'-'} 格</strong> · 等待下一位玩家`;
 $('statusText').textContent=state.stage==='rolling'?'🎲 掷骰中':state.stage==='ready'?'✨ 当前玩家准备':'🎉 等待下一回合';$('logList').innerHTML=(state.logs||[]).slice(0,4).map(l=>`<div class="log-item">${esc(l)}</div>`).join('')||'<div class="log-item">静待开局 ✨</div>';
 if(state.stage==='rolling'){if(!diceTimer){$('die').classList.add('rolling');diceTimer=setInterval(()=>renderDie(1+Math.floor(Math.random()*6)),90)}}else{if(diceTimer){clearInterval(diceTimer);diceTimer=null}$('die').classList.remove('rolling');renderDie(state.lastRoll||1)}
 renderOverlay();}
function accept(packet){if(!packet||packet.kind!=='snapshot')return;if(packet.session===latestSession&&packet.rev<=latestRev)return;if(packet.session!==latestSession&&lastUpdated&&packet.ts<lastUpdated)return;
 latestSession=packet.session;latestRev=packet.rev;lastUpdated=packet.ts||Date.now();if(packet.state&&packet.state.players?.length){state=packet.state;latestOverlay=packet.overlay||null;render()}else if(!state){$('waiting').classList.remove('hidden')}
 updateConnectivity();}
function updateConnectivity(){let active=!!lastUpdated&&(Date.now()-lastUpdated<11000);$('connection').textContent=active?'● 实时联动中':'● 等待主持端';$('connection').classList.toggle('offline',!active)}
try{const bc=typeof BroadcastChannel!=='undefined'?new BroadcastChannel(SYNC_CHANNEL):null;if(bc)bc.onmessage=e=>accept(e.data)}catch(e){}
window.addEventListener('message',e=>{if(e.source===window.opener)accept(e.data)});if(window.opener){try{window.opener.postMessage({kind:'projector-ready'},'*')}catch(e){}}
window.addEventListener('storage',e=>{if(e.key===SYNC_KEY&&e.newValue){try{accept(JSON.parse(e.newValue))}catch(err){}}});
try{const saved=localStorage.getItem(SYNC_KEY);if(saved)accept(JSON.parse(saved))}catch(e){}
if(location.protocol==='http:'||location.protocol==='https:'){setInterval(async()=>{try{const res=await fetch('/api/state?ts='+Date.now(),{cache:'no-store'});if(res.ok){const obj=await res.json();if(obj?.kind==='snapshot')accept(obj)}}catch(e){}},500)}
setInterval(updateConnectivity,1000);renderDie(1);
document.addEventListener('keydown',e=>{if(e.key.toLowerCase()==='f'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();if(document.fullscreenElement)document.exitFullscreen?.();else document.documentElement.requestFullscreen?.().catch(()=>{})}});
})();
</script></body></html>