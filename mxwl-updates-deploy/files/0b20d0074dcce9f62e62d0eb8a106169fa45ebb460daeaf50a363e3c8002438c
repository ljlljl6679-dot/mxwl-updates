<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>真心话大冒险·投屏端</title><style>
*{box-sizing:border-box}html,body{height:100%;margin:0;font-family:"Microsoft YaHei",sans-serif;color:white}body{overflow:hidden;background:radial-gradient(circle at 18% 12%,#5c267c55,transparent 30%),linear-gradient(135deg,#10051f,#28104b 60%,#4b1d76)}.app{height:100%;padding:22px;display:flex;flex-direction:column;gap:16px}.top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.brand{display:flex;gap:12px;align-items:center}.logo{width:62px;height:62px;border-radius:19px;display:grid;place-items:center;font-size:34px;background:linear-gradient(135deg,#d88cff,#7e67ff)}h1{margin:0;font-size:58px}.sub{font-size:13px;color:#cfc2e5}.timer{font-size:46px;font-weight:1000;padding:10px 22px;border-radius:18px;background:#0003}.round{text-align:right;color:#cfc2e5}.round b{display:block;color:#fff;font-size:28px}.stage{flex:1;border-radius:30px;background:#ffffff16;border:1px solid #ffffff22;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:34px}.mode{font-size:24px;color:#d8c8ec}.badge{display:inline-block;padding:8px 16px;border-radius:999px;background:#b875ff33;font-weight:900}.player{font-size:92px;font-weight:1000;margin:22px 0 14px}.prompt{max-width:1080px;font-size:50px;font-weight:1000;line-height:1.45;color:#f4eaff}.footer{display:grid;grid-template-columns:1fr auto 1fr;gap:12px}.foot{padding:11px 14px;border-radius:17px;background:#ffffff14;border:1px solid #ffffff22;color:#cfc2e5}.center{text-align:center;color:#fff}.right{text-align:right}.overlay{position:fixed;inset:0;background:#090313e8;display:none;align-items:center;justify-content:center;z-index:10;text-align:center}.overlay.show{display:flex}.result{padding:38px 52px;border-radius:30px;background:linear-gradient(145deg,#653497f0,#220f41f5);border:1px solid #ffffff2a}.emoji{font-size:88px}.headline{font-size:52px;font-weight:1000}.msg{font-size:28px;color:#ead8ff;margin-top:10px}.full{position:fixed;right:15px;bottom:15px;border:1px solid #ffffff22;border-radius:999px;padding:10px 13px;background:#0005;color:#fff;cursor:pointer}
</style></head><body><div class="app"><div class="top"><div class="brand"><div class="logo">🎭</div><div><h1>真心话大冒险</h1><div class="sub">语音厅投屏端</div></div></div><div class="timer" id="timer">60s</div><div class="round">当前回合<b>第 <span id="round">0</span> 回合</b></div></div><div class="stage"><div class="mode">当前模式：<span class="badge" id="mode">等待开始</span></div><div class="player" id="player">谁会被选中？</div><div class="prompt" id="prompt">等待主持开始游戏</div></div><div class="footer"><div class="foot">🎤 被选中的玩家请完成当前题目</div><div class="foot center">完成 <b id="done">0</b> · 跳过 <b id="skip">0</b></div><div class="foot right" id="status">等待开始</div></div></div><div class="overlay" id="overlay"><div class="result"><div class="emoji" id="emoji">🎉</div><div class="headline" id="headline">完成！</div><div class="msg" id="msg"></div></div></div><button class="full" id="full">⛶ 全屏</button><script>
const $=id=>document.getElementById(id);function render(s){$('player').textContent=s.player||'谁会被选中？';$('mode').textContent=s.mode||'等待开始';$('prompt').textContent=s.prompt||'等待主持开始游戏';$('timer').textContent=(s.timeLeft??60)+'s';$('round').textContent=s.rounds||0;$('done').textContent=s.done||0;$('skip').textContent=s.skipped||0}function pop(e,t,m){$('emoji').textContent=e;$('headline').textContent=t;$('msg').textContent=m||'';$('overlay').classList.add('show');setTimeout(()=>$('overlay').classList.remove('show'),2200)}window.addEventListener('message',e=>{let m=e.data;if(!m)return;if(['state','new-round','reroll','complete','skip','timeout'].includes(m.type)){render(m);if(m.type==='new-round')$('status').textContent='挑战进行中';if(m.type==='reroll')$('status').textContent='主持已换题';if(m.type==='complete'){ $('status').textContent='挑战完成';pop('🎉','完成！',(m.player||'玩家')+' 完成了本题') }if(m.type==='skip'){ $('status').textContent='本题跳过';pop('⏭','跳过本题',m.player||'') }if(m.type==='timeout'){ $('status').textContent='时间到';pop('⏰','时间到！',m.player||'') }}});if(window.opener)window.opener.postMessage({type:'projector-ready'},'*');$('full').onclick=async()=>{try{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();else await document.exitFullscreen()}catch(e){}};
</script></body></html>