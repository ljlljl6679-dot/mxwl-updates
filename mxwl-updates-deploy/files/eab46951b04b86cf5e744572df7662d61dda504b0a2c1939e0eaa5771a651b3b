const k=choices[Math.floor(Math.random()*choices.length)],list=levelsFor(k,diff);if(!state.drawHistory||typeof state.drawHistory!=='object')state.drawHistory={};let key=k+':'+diff,history=state.drawHistory[key];if(!Array.isArray(history))history=[];const pool=list.filter(q=>!history.includes(q));if(!pool.length)history=[];const options=pool.length?pool:list;const question=options[Math.floor(Math.random()*options.length)];history.push(question);state.drawHistory[key]=history;save();return {category:k,diff,text:question,left:Math.max(0,list.length-history.length),total:list.length};}
