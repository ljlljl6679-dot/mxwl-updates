function renderSetup(){const container=$('setupPlayers');container.innerHTML=setupNames.map((v,i)=>`<div class="setup-player"><span class="avatar" style="background:${colors[i%colors.length]}">${i+1}</span><input aria-label="玩家${i+1}昵称" data-idx="${i}" maxlength="12" value="${esc(v)}" placeholder="第${i+1}位昵称"/><button class="remove-btn" data-remove="${i}" title="移除玩家" ${setupNames.length<=2?'disabled':''}>×</button></div>`).join('');$('addPlayerBtn').disabled=setupNames.length>=6;let hasOld=false;try{const old=JSON.parse(localStorage.getItem(KEY));hasOld=!!(old&&old.players&&old.players.length)}catch(e){}$('resumeBtn').style.display=hasOld?'':'none';}
function showSetup(){setupNames=state?.players?.map(p=>p.name)||[...defaultNames];renderSetup();$('setupOverlay').classList.remove('hidden')}
function newGame(names){liveOverlay=null;const nameList=names.slice(0,6).map((n,i)=>n.trim()||`${i+1}号麦`);state={players:nameList.map((name,id)=>({id,name,balance:START_CASH,position:0,skipTurns:0})),ownership:{},current:0,round:1,turn:1,stage:'ready',lastRoll:0,logs:[],difficulty:($('gameDifficulty').value||'normal'),drawHistory:{},chanceHistory:[],boardVersion:BOARD_VERSION};pendingModal=false;log('40格·24地盘·六大街区正式开放！');$('setupOverlay').classList.add('hidden');render();renderDie(1);playTone(660,.15);toast('✨ 开局成功！请第一位玩家掷骰子');}
function restore(){liveOverlay=null;try{let g=JSON.parse(localStorage.getItem(KEY));if(!g||!Array.isArray(g.players)||g.players.length<2||g.players.length>6)throw new Error('not saved');if(!g.ownership||!Array.isArray(g.logs))throw new Error('corrupt');state=g;if((state.boardVersion||1)<BOARD_VERSION){const oldToNew=Object.fromEntries(OLD_TILE_NAMES.map((name,i)=>[i,tiles.findIndex(t=>t.name===name)]));const mapped={};for(const [oldId,owner] of Object.entries(state.ownership)){const target=oldToNew[Number(oldId)];if(target>=0&&tiles[target]?.type==='property'&&owner&&Number.isInteger(owner.playerId))mapped[target]=owner}state.ownership=mapped;state.players.forEach(p=>{const newPos=oldToNew[Number(p.position)||0];p.position=newPos>=0?newPos:0});state.boardVersion=BOARD_VERSION;state.logs.unshift('旧版24格存档已升级为40格，地盘按名称保留。');}
state.players.forEach((p,i)=>{p.id=i;p.position=((Number(p.position)||0)%tiles.length+tiles.length)%tiles.length;p.skipTurns=Math.max(0,Number(p.skipTurns)||0)});if(!['ready','ended'].includes(state.stage))state.stage='ended';state.current=Math.max(0,Math.min(state.current,state.players.length-1));pendingModal=false;state.difficulty=state.difficulty||'normal';state.drawHistory=state.drawHistory||{};state.chanceHistory=state.chanceHistory||[];$('gameDifficulty').value=state.difficulty;$('setupOverlay').classList.add('hidden');render();renderDie(state.lastRoll||1);toast('已恢复上次游戏进度')}catch(e){toast('无法恢复进度，请开启新游戏')}}
function openEvent(data){pendingModal=true;liveOverlay=eventPublicData(data);syncOut();const modal=$('eventContent');modal.innerHTML=`<div class="modal-icon">${data.icon||'✨'}</div><div class="modal-tag">${esc(data.tag||'STARLIGHT EVENT')}</div><h2 id="eventTitle">${esc(data.title)}</h2><p class="${data.isQuestion?'event-question':''}">${esc(data.desc||'')}</p>${data.subline?`<div class="event-mini">${esc(data.subline)}</div>`:''}${data.highlight?`<div class="highlight">${esc(data.highlight)}</div>`:''}<div class="modal-actions" id="eventActions"></div>${data.remark?`<div class="modal-remark">${esc(data.remark)}</div>`:''}`;const actions=$('eventActions');data.actions.forEach(a=>{const btn=document.createElement('button');btn.className=a.main?'primary-btn':('secondary-btn'+(a.keepOpen?' reroll-btn':''));btn.textContent=a.label;btn.disabled=!!a.disabled;btn.addEventListener('click',()=>{if(btn.disabled)return;if(a.keepOpen){a.fn();return}pendingModal=false;liveOverlay=null;$('eventOverlay').classList.add('hidden');a.fn();state.stage='ended';render();});actions.appendChild(btn)});$('eventOverlay').classList.remove('hidden');}
const delay=ms=>new Promise(r=>setTimeout(r,ms));
async function roll(){if(!state||state.stage!=='ready'||pendingModal)return;state.stage='rolling';render();const rollBtn=$('rollBtn');rollBtn.disabled=true;$('die').classList.add('rolling');let n=1;const spin=setInterval(()=>{n=1+Math.floor(Math.random()*6);renderDie(n);playTone(250+n*46,.045)},72);await delay(780);clearInterval(spin);$('die').classList.remove('rolling');n=1+Math.floor(Math.random()*6);renderDie(n);state.lastRoll=n;playTone(810,.14);const p=state.players[state.current];log(`${p.name} 掷出了 ${n} 点`);for(let step=0;step<n;step++){p.position=(p.position+1)%tiles.length;if(p.position===0){p.balance+=LAP_BONUS;log(`${p.name} 路过起点，获得 ${LAP_BONUS} 音浪币`);playTone(850,.11)}renderBoard();await delay(215)}await delay(200);resolveTile(p.position)}
function finishEvent(data){openEvent({...data,actions:[{label:'好的，继续冒险',main:true,fn:()=>{}}]})}
function showBoardChallenge(p,tile,pos,retries){let categories=tile.categories||['lyrics','social','quiz'];let category=categories[Math.floor(Math.random()*categories.length)];let diff=state.difficulty||'normal',q=drawFromBank(category,diff);if(!q){toast('这个难度的题库为空，请调整题库');state.stage='ended';render();return;}let meta=taskMeta[q.category];playTone(680,.11);openEvent({icon:meta[0],tag:'VOICE ROOM CHALLENGE · '+difficultyNames[diff],title:tile.name+' · '+meta[1],desc:q.text,isQuestion:true,subline:`${meta[0]} ${meta[1]}　·　${difficultyNames[diff]}难度　·　本组剩余 ${q.left} / ${q.total} 道`,remark:'主持人判定完成情况；互动以玩家自愿为前提。整组抽完后自动重新洗牌。',actions:[{label:'✨ 完成 +100',main:true,fn:()=>{p.balance+=100;log(`${p.name} 完成「${meta[1]}」挑战 +100 音浪币`);playTone(920,.15);confetti()}},...(retries>0?[{label:'🎲 换一题（1次）',keepOpen:true,fn:()=>showBoardChallenge(p,tile,pos,0)}]:[]),{label:'暂时跳过',fn:()=>log(`${p.name} 选择跳过「${meta[1]}」任务`)},{label:'未完成 -30',fn:()=>{p.balance-=30;log(`${p.name} 未完成挑战 -30 音浪币`)}}]});}
function showManualDraw(){if(!state){toast('请先开启一局游戏');return}populateCategorySelectors();$('hostDifficulty').value=state.difficulty||'normal';$('hostQuestion').textContent='选择分类和难度，点击下方抽出你的挑战题目';$('hostDrawIcon').textContent='✨';$('hostQuestionMeta').textContent='本局已抽题目自动避重，全部抽完后才重置';$('copyTaskBtn').disabled=true;lastManualText='';$('hostDrawOverlay').classList.remove('hidden')}
function manualDraw(){if(!state)return;const q=drawFromBank($('hostCategory').value,$('hostDifficulty').value);if(!q)return toast('当前分类没有题目');const meta=taskMeta[q.category];lastManualText=q.text;$('hostDrawIcon').textContent=meta[0];$('hostQuestion').textContent=q.text;$('hostQuestionMeta').textContent=`${meta[1]} · ${difficultyNames[q.diff]}难度 · 本组剩余 ${q.left}/${q.total} 道`;$('copyTaskBtn').disabled=false;playTone(760,.13);refreshBankUI();if(liveOverlay?.kind==='manual')screenManual(true)}
function showEditor(){populateCategorySelectors();$('editorDifficulty').value='normal';$('editorCategory').value='truth';fillEditor();$('editorOverlay').classList.remove('hidden')}
function fillEditor(){let category=$('editorCategory').value,diff=$('editorDifficulty').value;editorLastCategory=category;editorLastDifficulty=diff;$('taskEditor').value=levelsFor(category,diff).join('\n');editorDirty=false;updateEditorCounter();}
function updateEditorCounter(){const lines=$('taskEditor').value.split(/\r?\n/).map(s=>s.trim()).filter(Boolean),category=$('editorCategory').value, diff=$('editorDifficulty').value;$('editorCount').textContent=`${taskMeta[category]?.[1]||'自定义'} · ${difficultyNames[diff]}难度 | ${lines.length} 道题 · 最多保留250道/组`}
function saveEditor(){const category=$('editorCategory').value,diff=$('editorDifficulty').value,lines=[...new Set($('taskEditor').value.split(/\r?\n/).map(s=>s.trim()).filter(Boolean))].slice(0,250);if(!lines.length){toast('每个分类至少保留一道题');return}bank[category][diff]=lines;editorDirty=false;saveBank();refreshBankUI();updateEditorCounter();toast(`✓ 已保存「${taskMeta[category][1]}·${difficultyNames[diff]}」${lines.length} 道`)}
function resolveTile(pos){const tile=tiles[pos],p=state.players[state.current];if(tile.type==='start'){p.balance+=100;log(`${p.name} 抵达星光起点，额外得到 100 音浪币`);confetti();finishEvent({icon:'🚩',tag:'START',title:'重返星光起点',desc:'你又回到了梦想出发的地方！',highlight:'额外奖励 +100 音浪币'});return}
if(tile.type==='bonus'){p.balance+=tile.delta;log(`${p.name} 触发「${tile.name}」，获得 ${tile.delta} 音浪币`);playTone(880,.16);confetti();finishEvent({icon:tile.icon,tag:'LUCKY REWARD',title:tile.name,desc:'幸运值爆棚！这份小惊喜送给你。',highlight:`+${tile.delta} 音浪币`});return}
if(tile.type==='rest'){p.skipTurns++;log(`${p.name} 进入休息区，下一次轮到时跳过`);finishEvent({icon:'💤',tag:'REST AREA',title:'暂停一回合',desc:'星光补给中，下次轮到你时自动跳过一回合。',highlight:'休息 × 1 回合'});return}
if(tile.type==='chance'){const card=drawChance();p.balance+=card.delta;log(`${p.name} 抽到「${card.title}」，${card.delta>=0?'+':''}${card.delta} 音浪币`);playTone(card.delta>=0?870:330,.2);if(card.delta>=180)confetti();finishEvent({icon:card.icon,tag:'MYSTERY CARD',title:card.title,desc:card.desc,highlight:`${card.delta>=0?'+':''}${card.delta} 音浪币`});return}
if(tile.type==='task'){showBoardChallenge(p,tile,pos,1);return}
if(tile.type==='property'){const owner=state.ownership[pos];if(!owner){openEvent({icon:tile.icon,tag:'PROPERTY PURCHASE',title:`发现地盘 · ${tile.name}`,desc:`所属街区：${districts[tile.district].name}（4块地盘）\n购入价：${tile.price} 音浪币\n基础租金：${tile.rent} 音浪币\n集齐本街区4块地，区内租金×1.5`,highlight:`你的余额：${fmt(p.balance)} 音浪币`,actions:[{label:`👑 购买 -${tile.price}`,main:true,disabled:p.balance<tile.price,fn:()=>{p.balance-=tile.price;state.ownership[pos]={playerId:p.id,level:1};log(`${p.name} 购买了「${tile.name}」，地价 ${tile.price}`);playTone(820,.16);confetti()}},{label:'这次不买',fn:()=>{log(`${p.name} 放弃购买「${tile.name}」`)}}],remark:p.balance<tile.price?'你的游戏币不足，暂时无法购买。':'地盘越多，其他玩家踩到时的租金收益越高。'});return}
if(owner.playerId===p.id){const upgradeCost=Math.round(tile.price*.5),can=owner.level<3&&p.balance>=upgradeCost;openEvent({icon:tile.icon,tag:'YOUR PROPERTY',title:`欢迎回家 · ${tile.name}`,desc:`你是这块地盘的主人！\n当前等级 Lv.${owner.level} · 当前租金 ${tile.rent*owner.level} 币\n升级后租金随等级提高。`,highlight:`你的余额：${fmt(p.balance)} 音浪币`,actions:[{label:owner.level>=3?'👑 已满级':`⬆ 升级 -${upgradeCost}`,main:true,disabled:!can,fn:()=>{owner.level++;p.balance-=upgradeCost;log(`${p.name} 将「${tile.name}」升级到 Lv.${owner.level}`);playTone(850,.17)}},{label:'保持现状',fn:()=>{log(`${p.name} 检查了自己的「${tile.name}」`)}}],remark:owner.level>=3?'你的地盘已经满级！':p.balance<upgradeCost?'游戏币不足，无法升级。':'地盘最多可升级到 3 级。'});return}
const landlord=state.players[owner.playerId],rent=actualRent(tile,owner);p.balance-=rent;landlord.balance+=rent;log(`${p.name} 向 ${landlord.name} 支付「${tile.name}」租金 ${rent} 币`);playTone(355,.17);finishEvent({icon:'🏠',tag:'RENT PAYMENT',title:'踩到别人的地盘！',desc:`「${tile.name}」属于 ${landlord.name}\n地盘等级 Lv.${owner.level}${monopolyOwner(tile.district)===owner.playerId?" · 街区垄断加成×1.5":""}，本次租金已自动结算。`,highlight:`-${rent} 音浪币`,remark:`${landlord.name} +${rent} 币 · ${p.name} -${rent} 币`});return}}
function nextTurn(){if(!state||state.stage!=='ended'||pendingModal)return;liveOverlay=null;let idx=state.current;for(let k=0;k<state.players.length*3;k++){idx=(idx+1)%state.players.length;if(idx===0)state.round++;const p=state.players[idx];if(p.skipTurns>0){p.skipTurns--;log(`${p.name} 本轮休息，已自动跳过`);continue}break}state.current=idx;state.turn++;state.stage='ready';state.lastRoll=0;playTone(600,.11);render();renderDie(1)}
function changeCoins(sign){if(!state)return;const id=parseInt($('hostPlayer').value,10);const amount=Math.round(Number($('hostAmount').value));if(!Number.isInteger(amount)||amount<=0||amount>99999){toast('请输入 1～99999 的有效数额');return}const p=state.players[id];if(!p)return;p.balance+=sign*amount;log(`主持人${sign>0?'奖励':'扣除'} ${p.name} ${amount} 音浪币`);render();$('hostPlayer').value=String(id);toast(`${p.name} ${sign>0?'+':'-'}${amount} 音浪币`);playTone(sign>0?900:440,.11)}
function showRanking(){if(!state)return;let ordered=[...state.players].sort((a,b)=>totalAsset(b)-totalAsset(a));$('rankingList').innerHTML=ordered.map((p,i)=>`<div class="ranking-row"><div><div class="rank-name">${['🥇','🥈','🥉'][i]||'✦'} ${esc(p.name)}</div><small>持币 ${fmt(p.balance)} · 地盘 ${countProperty(p.id)} 块</small></div><div class="score">${fmt(totalAsset(p))}<span style="font-size:10px;display:block;color:#bca9d0;text-align:right">总资产</span></div></div>`).join('');$('rankingOverlay').classList.remove('hidden');if(ordered[0].balance>0)playTone(800,.18)}
$('setupPlayers').addEventListener('input',e=>{const idx=Number(e.target.dataset.idx);if(e.target.matches('input[data-idx]'))setupNames[idx]=e.target.value});$('setupPlayers').addEventListener('click',e=>{const b=e.target.closest('button[data-remove]');if(!b||setupNames.length<=2)return;setupNames.splice(Number(b.dataset.remove),1);renderSetup()});$('addPlayerBtn').addEventListener('click',()=>{if(setupNames.length<6){setupNames.push(`${setupNames.length+1}号麦`);renderSetup()}});$('startBtn').addEventListener('click',()=>newGame(setupNames));$('resumeBtn').addEventListener('click',restore);
$('catalogBtn').addEventListener('click',()=>showCatalog(0));$('closeCatalogBtn').addEventListener('click',()=>$('catalogOverlay').classList.add('hidden'));$('catalogTabs').addEventListener('click',e=>{const b=e.target.closest('[data-district]');if(b){selectedDistrict=Number(b.dataset.district);renderCatalog()}});$('board').addEventListener('click',e=>{const cell=e.target.closest('.space[data-property]');if(cell&&!pendingModal&&$('setupOverlay').classList.contains('hidden'))showCatalog(tiles[Number(cell.dataset.property)].district)});
$('rollBtn').addEventListener('click',roll);$('nextBtn').addEventListener('click',nextTurn);$('addCoins').addEventListener('click',()=>changeCoins(1));$('subCoins').addEventListener('click',()=>changeCoins(-1));$('rankingBtn').addEventListener('click',showRanking);$('closeRankingBtn').addEventListener('click',()=>$('rankingOverlay').classList.add('hidden'));
$('soundBtn').addEventListener('click',()=>{sound=!sound;$('soundBtn').textContent=sound?'🔊 音效开':'🔇 音效关';if(sound)playTone(780,.12)});
$('fullBtn').addEventListener('click',()=>{try{if(!document.fullscreenElement)document.documentElement.requestFullscreen?.();else document.exitFullscreen?.()}catch(e){toast('浏览器不支持全屏，请按 F11')}});
$('howBtn').addEventListener('click',()=>$('howOverlay').classList.remove('hidden'));$('closeHowBtn').addEventListener('click',()=>$('howOverlay').classList.add('hidden'));
$('newBtn').addEventListener('click',()=>{if(state&&confirm('确定重新开局吗？\n新游戏将覆盖当前保存的进度。'))showSetup()});
$('saveBtn').addEventListener('click',()=>{save();syncOut();toast('✓ 当前进度已保存在此浏览器')});
$('gameDifficulty').addEventListener('change',e=>{if(state){state.difficulty=e.target.value;save();toast('已切换到 '+difficultyNames[e.target.value]+'模式')}else toast('开局后生效')});
$('hostDrawBtn').addEventListener('click',showManualDraw);
$('manualDrawBtn').addEventListener('click',manualDraw);
$('closeDrawBtn').addEventListener('click',()=>{$('hostDrawOverlay').classList.add('hidden');if(liveOverlay?.kind==='manual')screenManual(false)});
$('copyTaskBtn').addEventListener('click',async()=>{if(!lastManualText)return;try{await navigator.clipboard.writeText(lastManualText);toast('✓ 题目已复制')}catch(e){toast('复制受限，可以选中题目手动复制')}});
$('editorBtn').addEventListener('click',showEditor);
$('cancelTasksBtn').addEventListener('click',()=>{if(editorDirty&&!confirm('题库有未保存的修改，确定直接关闭吗？'))return;$('editorOverlay').classList.add('hidden');editorDirty=false});
function switchEditorGroup(){if(editorDirty&&!confirm('这一组的修改还没有保存，确定放弃本组修改并切换吗？')){$('editorCategory').value=editorLastCategory;$('editorDifficulty').value=editorLastDifficulty;return}fillEditor()}
$('editorCategory').addEventListener('change',switchEditorGroup);
$('editorDifficulty').addEventListener('change',switchEditorGroup);
$('taskEditor').addEventListener('input',()=>{editorDirty=true;updateEditorCounter()});
$('saveTasksBtn').addEventListener('click',saveEditor);
$('resetTasksBtn').addEventListener('click',()=>{const cat=$('editorCategory').value,diff=$('editorDifficulty').value;if(!defaultBank[cat])return toast('此分类为旧版自定义题库');$('taskEditor').value=defaultBank[cat][diff].join('\n');editorDirty=true;updateEditorCounter();toast('已载入本组默认题目，点击保存生效')});
$('resetAllTasksBtn').addEventListener('click',()=>{if(!confirm('恢复全部 288 道内置题目？本操作会覆盖你的所有自定义分类题目。'))return;bank=cloneBank();saveBank();populateCategorySelectors();fillEditor();refreshBankUI();toast('已恢复完整内置题库')});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!$('eventOverlay').classList.contains('hidden'))return;['howOverlay','editorOverlay','rankingOverlay','hostDrawOverlay'].forEach(id=>$(id).classList.add('hidden'))}if(e.key===' '&&!['INPUT','TEXTAREA','SELECT','BUTTON'].includes(document.activeElement.tagName)&&state?.stage==='ready'&&$('setupOverlay').classList.contains('hidden')&&['howOverlay','editorOverlay','rankingOverlay','hostDrawOverlay','eventOverlay'].every(id=>$(id).classList.contains('hidden'))){e.preventDefault();roll()}});
$('screenShowBtn').addEventListener('click',()=>screenManual(true));$('screenHideBtn').addEventListener('click',()=>screenManual(false));$('openScreenBtn').addEventListener('click',()=>{screenWindow=window.open('投屏端.html','voice_room_monopoly_projector','width=1580,height=980');if(!screenWindow){toast('浏览器拦截了弹窗，请允许弹窗或手动打开投屏端')}else{setTimeout(syncOut,950)}});window.addEventListener('message',e=>{if(e.source===screenWindow&&e.data?.kind==='projector-ready')syncOut()});populateCategorySelectors();refreshBankUI();renderDie(1);renderSetup();if(!localStorage.getItem(KEY))syncOut();setInterval(()=>{if(state)syncOut()},2700);
})();
</script></body></html>