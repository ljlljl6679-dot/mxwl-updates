<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>你画我猜 · 主持控制端</title>
<style>
:root{
  --bg1:#140824;--bg2:#2b1250;--bg3:#52217d;
  --panel:rgba(255,255,255,.10);--border:rgba(255,255,255,.14);
  --text:#fff;--muted:#d9cfaa;--gold:#b874ff;--orange:#7c66ff;
  --danger:#d95dff;--green:#e7d4ff;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;font-family:"Microsoft YaHei","PingFang SC",system-ui,sans-serif;color:var(--text)}
body{
  background:
    radial-gradient(circle at 18% 10%,rgba(191,116,255,.22),transparent 30%),
    radial-gradient(circle at 85% 18%,rgba(124,102,255,.20),transparent 32%),
    linear-gradient(135deg,var(--bg1),var(--bg2) 58%,var(--bg3));
}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.13;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:42px 42px}
.app{min-height:100%;padding:18px;display:flex;flex-direction:column;gap:14px}
.top{display:flex;justify-content:space-between;align-items:center;gap:12px}
.brand{display:flex;gap:13px;align-items:center}
.logo{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;font-size:32px;background:linear-gradient(135deg,#ffe36b,#7c66ff);box-shadow:0 10px 30px rgba(163,105,255,.30)}
.title{font-size:clamp(28px,3.5vw,50px);font-weight:1000;letter-spacing:2px}
.sub{font-size:13px;color:var(--muted);margin-top:6px}
.actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}
button{border:none;cursor:pointer;border-radius:14px;padding:11px 14px;font-weight:900;font-size:15px;background:linear-gradient(135deg,#ffe36b,#7c66ff);color:#3a2a00;box-shadow:0 8px 20px rgba(124,102,255,.20)}
button.secondary{background:rgba(255,255,255,.09);color:white;border:1px solid var(--border);box-shadow:none}
button.danger{background:linear-gradient(135deg,#ffbf3e,#d95dff);color:#462100}
button.active{outline:2px solid #fff;outline-offset:2px}
.main{flex:1;display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:14px;min-height:0}
.panel{background:var(--panel);border:1px solid var(--border);border-radius:26px;backdrop-filter:blur(14px);box-shadow:0 18px 55px rgba(0,0,0,.22)}
.left{padding:14px;display:flex;flex-direction:column;gap:12px;min-height:680px}
.statusbar{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:10px 14px}
.private{font-size:14px;color:var(--muted)}
.private b{display:block;color:#ead8ff;font-size:26px;margin-top:2px;letter-spacing:3px}
.timer{font-size:30px;font-weight:1000;padding:8px 16px;border-radius:16px;background:rgba(0,0,0,.18)}
.pub{text-align:right;font-size:13px;color:var(--muted)}
.canvaswrap{flex:1;min-height:470px;background:#fff;border-radius:22px;overflow:hidden;position:relative;box-shadow:0 12px 36px rgba(0,0,0,.22)}
canvas{width:100%;height:100%;display:block;touch-action:none;cursor:crosshair}
.watermark{position:absolute;left:16px;bottom:10px;color:#bca9d2;font-size:12px;pointer-events:none}
.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
.colors{display:flex;gap:7px}
.color{width:28px;height:28px;border-radius:50%;border:2px solid white;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.25)}
.color.active{outline:3px solid #e1c7ff;outline-offset:2px}
.size{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px}
input[type=range]{accent-color:#9a63ff;width:105px}
.side{padding:14px;display:flex;flex-direction:column;gap:12px}
.card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);border-radius:19px;padding:14px}
.card h3{margin:0 0 10px;font-size:16px}
.bigword{font-size:34px;font-weight:1000;text-align:center;letter-spacing:5px;padding:14px;border-radius:15px;background:rgba(0,0,0,.20);color:#ead7ff}
.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
input[type=text]{width:100%;border:1px solid rgba(255,255,255,.13);outline:none;background:rgba(0,0,0,.20);color:white;border-radius:13px;padding:11px 12px;font-size:15px}
.guesslog{max-height:150px;overflow:auto;font-size:13px;color:#d9cbea;margin-top:9px}
.guessline{padding:5px 0;border-bottom:1px dashed rgba(255,255,255,.08)}
.good{color:#ead6ff;font-weight:900}
.connection{font-size:13px;line-height:1.55;color:var(--muted)}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#ff8b52;margin-right:6px}
.dot.on{background:#dfff77;box-shadow:0 0 14px rgba(223,255,119,.6)}
.tip{font-size:12px;color:#bfaed5;line-height:1.6}
@media(max-width:950px){.main{grid-template-columns:1fr}.left{min-height:620px}.side{min-height:420px}}
</style>
</head>
<body>
<div class="app">
  <div class="top">
    <div class="brand">
      <div class="logo">🎨</div>
      <div><div class="title">你画我猜 · 控制端</div><div class="sub">主持 / 画手使用 · 题目只在这里显示</div></div>
    </div>
    <div class="actions">
      <button id="openProjector">🖥 打开投屏窗口</button>
      <button class="secondary" id="fullscreen">⛶ 控制端全屏</button>
    </div>
  </div>

  <div class="main">
    <section class="panel left">
      <div class="statusbar">
        <div class="private">画手题目<b id="privateWord">等待出题</b></div>
        <div class="timer" id="timer">60s</div>
        <div class="pub">投屏显示<br><b id="publicWord">＿＿＿</b></div>
      </div>

      <div class="canvaswrap" id="canvasWrap">
        <canvas id="board"></canvas>
        <div class="watermark">主持控制端画板</div>
      </div>

      <div class="toolbar">
        <div class="colors">
          <div class="color active" data-color="#17131f" style="background:#17131f"></div>
          <div class="color" data-color="#9a63ff" style="background:#9a63ff"></div>
          <div class="color" data-color="#d95dff" style="background:#d95dff"></div>
          <div class="color" data-color="#ef5da8" style="background:#ef5da8"></div>
          <div class="color" data-color="#2e86de" style="background:#2e86de"></div>
          <div class="color" data-color="#22a06b" style="background:#22a06b"></div>
        </div>
        <div class="size">粗细 <input id="size" type="range" min="2" max="34" value="7"></div>
        <button class="secondary" id="eraser">🧽 橡皮擦</button>
        <button class="secondary" id="undo">↶ 撤销</button>
        <button class="secondary" id="clear">🗑 清空</button>
      </div>
    </section>

    <aside class="panel side">
      <div class="card">
        <h3>🎲 出题控制</h3>
        <div class="bigword" id="answerBox">等待开始</div>
        <div style="height:9px"></div>
        <div class="row">
          <button id="start">开始出题</button>
          <button class="danger" id="skip">换一题</button>
        </div>
        <div style="height:8px"></div>
        <button class="secondary" id="reveal" style="width:100%">👀 公布答案</button>
      </div>

      <div class="card">
        <h3>🎤 当前画手</h3>
        <input type="text" id="drawerName" value="本轮画手" maxlength="16">
      </div>

      <div class="card">
        <h3>💬 主持录入猜测</h3>
        <div style="display:grid;grid-template-columns:1fr auto;gap:8px">
          <input type="text" id="guess" placeholder="输入玩家猜的答案">
          <button id="submitGuess">提交</button>
        </div>
        <div class="guesslog" id="guessLog"><div class="guessline">等待开始…</div></div>
      </div>

      <div class="card connection">
        <h3>📡 投屏连接</h3>
        <div><span class="dot" id="dot"></span><span id="connText">尚未打开投屏窗口</span></div>
        <div class="tip" style="margin-top:8px">建议：点击“打开投屏窗口”后，把新窗口拖到第二块屏幕，再全屏。投屏端不会接收隐藏答案。</div>
      </div>

      <div class="card">
        <h3>玩法</h3>
        <div class="tip">① 主持点击开始出题。<br>② 画手只看控制端题目并作画。<br>③ 观众只看投屏窗口。<br>④ 猜中后可由主持提交，或直接点公布答案。<br>⑤ 换题会自动清空画板并重置 60 秒。</div>
      </div>
    </aside>
  </div>
</div>

<script>
const words=[
{w:"小猫",c:"动物"},{w:"企鹅",c:"动物"},{w:"长颈鹿",c:"动物"},{w:"大熊猫",c:"动物"},{w:"兔子",c:"动物"},{w:"海豚",c:"动物"},{w:"螃蟹",c:"动物"},{w:"章鱼",c:"动物"},
{w:"汉堡",c:"食物"},{w:"奶茶",c:"食物"},{w:"火锅",c:"食物"},{w:"西瓜",c:"食物"},{w:"冰淇淋",c:"食物"},{w:"蛋糕",c:"食物"},{w:"棒棒糖",c:"食物"},{w:"包子",c:"食物"},
{w:"雨伞",c:"生活用品"},{w:"牙刷",c:"生活用品"},{w:"眼镜",c:"生活用品"},{w:"拖鞋",c:"生活用品"},{w:"手机",c:"生活用品"},{w:"耳机",c:"生活用品"},
{w:"吉他",c:"乐器"},{w:"钢琴",c:"乐器"},{w:"篮球",c:"运动"},{w:"足球",c:"运动"},{w:"羽毛球",c:"运动"},{w:"游泳",c:"运动"},
{w:"唱歌",c:"动作"},{w:"睡觉",c:"动作"},{w:"跑步",c:"动作"},{w:"自拍",c:"动作"},{w:"生日蛋糕",c:"场景"},{w:"摩天轮",c:"场景"},
{w:"电影院",c:"场景"},{w:"游乐园",c:"场景"},{w:"月亮",c:"自然"},{w:"彩虹",c:"自然"},{w:"雪人",c:"自然"},{w:"太阳",c:"自然"},
{w:"王冠",c:"物品"},{w:"钻石",c:"物品"},{w:"礼物盒",c:"物品"},{w:"口红",c:"物品"},{w:"麦克风",c:"语音厅"},{w:"耳返",c:"语音厅"}
];
const $=id=>document.getElementById(id);
let projector=null,current=null,round=0,timeLeft=60,timerId=null,revealed=false,started=false;
let drawing=false,color="#17131f",brush=7,eraser=false,history=[];
const canvas=$("board"),ctx=canvas.getContext("2d");

function mask(w){return Array.from(w).map(()=> "＿").join(" ")}
function publicState(extra={}){
  return Object.assign({
    type:"state",
    round,
    timeLeft,
    started,
    revealed,
    publicWord: current ? (revealed ? current.w : mask(current.w)) : "等待开始",
    category: current ? current.c : "",
    drawerName:$("drawerName").value.trim()||"本轮画手",
    latestGuess:null
  },extra);
}
function send(msg){
  try{ if(projector && !projector.closed) projector.postMessage(msg,"*"); }catch(e){}
}
window.addEventListener("message",e=>{
  if(!e.data)return;
  if(e.data.type==="projector-ready"){
    projector=e.source;
    $("dot").classList.add("on");
    $("connText").textContent="投屏窗口已连接";
    send(publicState());
    send({type:"canvas-snapshot",data:canvas.toDataURL("image/png")});
  }
});
setInterval(()=>{
  if(projector && projector.closed){
    projector=null;$("dot").classList.remove("on");$("connText").textContent="投屏窗口已关闭";
  }
},1000);

$("openProjector").onclick=()=>{
  projector=window.open("你画我猜_投屏端.html","drawGuessProjector","width=1280,height=720");
  setTimeout(()=>{ try{send(publicState());send({type:"canvas-snapshot",data:canvas.toDataURL("image/png")})}catch(e){} },800);
};

function resizeCanvas(){
  const r=$("canvasWrap").getBoundingClientRect();
  const old=canvas.width?canvas.toDataURL("image/png"):null;
  canvas.width=Math.max(300,Math.floor(r.width*devicePixelRatio));
  canvas.height=Math.max(300,Math.floor(r.height*devicePixelRatio));
  canvas.style.width=r.width+"px";canvas.style.height=r.height+"px";
  ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
  ctx.lineCap="round";ctx.lineJoin="round";ctx.fillStyle="#fff";ctx.fillRect(0,0,r.width,r.height);
  if(old){const im=new Image();im.onload=()=>{ctx.drawImage(im,0,0,r.width,r.height);send({type:"canvas-snapshot",data:canvas.toDataURL("image/png")})};im.src=old}
}
window.addEventListener("resize",resizeCanvas);setTimeout(resizeCanvas,60);

function pnt(e){const r=canvas.getBoundingClientRect(),p=e.touches?e.touches[0]:e;return{x:p.clientX-r.left,y:p.clientY-r.top,w:r.width,h:r.height}}
function saveState(){try{history.push(canvas.toDataURL("image/png"));if(history.length>25)history.shift()}catch(e){}}
function startDraw(e){e.preventDefault();drawing=true;saveState();const p=pnt(e);ctx.beginPath();ctx.moveTo(p.x,p.y);send({type:"stroke-start",x:p.x/p.w,y:p.y/p.h,color:eraser?"#ffffff":color,size:brush})}
function moveDraw(e){if(!drawing)return;e.preventDefault();const p=pnt(e);ctx.strokeStyle=eraser?"#ffffff":color;ctx.lineWidth=brush;ctx.lineTo(p.x,p.y);ctx.stroke();send({type:"stroke-move",x:p.x/p.w,y:p.y/p.h,color:eraser?"#ffffff":color,size:brush})}
function endDraw(){if(!drawing)return;drawing=false;ctx.closePath();send({type:"stroke-end"})}
canvas.addEventListener("mousedown",startDraw);canvas.addEventListener("mousemove",moveDraw);window.addEventListener("mouseup",endDraw);
canvas.addEventListener("touchstart",startDraw,{passive:false});canvas.addEventListener("touchmove",moveDraw,{passive:false});canvas.addEventListener("touchend",endDraw);

document.querySelectorAll(".color").forEach(el=>el.onclick=()=>{
  color=el.dataset.color;eraser=false;$("eraser").classList.remove("active");
  document.querySelectorAll(".color").forEach(x=>x.classList.remove("active"));el.classList.add("active");
});
$("size").oninput=e=>brush=Number(e.target.value);
$("eraser").onclick=()=>{eraser=!eraser;$("eraser").classList.toggle("active",eraser)};
$("clear").onclick=()=>clearBoard(true);
function clearBoard(sync){
  saveState();const r=canvas.getBoundingClientRect();ctx.fillStyle="#fff";ctx.fillRect(0,0,r.width,r.height);if(sync)send({type:"clear"});
}
$("undo").onclick=()=>{
  const last=history.pop();if(!last)return;
  const im=new Image();im.onload=()=>{const r=canvas.getBoundingClientRect();ctx.fillStyle="#fff";ctx.fillRect(0,0,r.width,r.height);ctx.drawImage(im,0,0,r.width,r.height);send({type:"canvas-snapshot",data:canvas.toDataURL("image/png")})};im.src=last;
};

function pick(){
  let n;do{n=words[Math.floor(Math.random()*words.length)]}while(current&&n.w===current.w);return n;
}
function startRound(){
  round++;current=pick();revealed=false;started=true;timeLeft=60;
  $("answerBox").textContent=current.w;$("privateWord").textContent=current.w;$("publicWord").textContent=mask(current.w);
  $("guessLog").innerHTML='<div class="guessline">新题开始，等待猜测…</div>';
  clearBoard(true);clearInterval(timerId);updateTimer();send(publicState({type:"round-start"}));
  timerId=setInterval(()=>{timeLeft--;updateTimer();send(publicState());if(timeLeft<=0){clearInterval(timerId);started=false;revealAnswer("时间到")}},1000);
}
function updateTimer(){$("timer").textContent=timeLeft+"s"}
function revealAnswer(reason="公布答案"){
  if(!current)return;revealed=true;started=false;clearInterval(timerId);
  $("publicWord").textContent=current.w;
  send(publicState({type:"reveal",reason}));
}
$("start").onclick=startRound;$("skip").onclick=startRound;$("reveal").onclick=()=>revealAnswer("主持公布答案");

function esc(s){return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function submitGuess(){
  const v=$("guess").value.trim();if(!v)return;
  const line=document.createElement("div");line.className="guessline";
  if(!current||!started){line.textContent="还没开始出题";$("guessLog").prepend(line);$("guess").value="";return}
  const correct=v===current.w;
  line.innerHTML=(correct?'✅ <span class="good">':'💬 ')+esc(v)+(correct?'</span>':'');
  $("guessLog").prepend(line);send(publicState({type:"guess",latestGuess:v,correct}));
  $("guess").value="";
  if(correct)revealAnswer("猜对啦");
}
$("submitGuess").onclick=submitGuess;$("guess").addEventListener("keydown",e=>{if(e.key==="Enter")submitGuess()});
$("drawerName").addEventListener("input",()=>send(publicState()));
$("fullscreen").onclick=async()=>{try{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();else await document.exitFullscreen()}catch(e){}};
</script>
</body>
</html>
