<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>梦露 转盘活动</title>
<style>
*{box-sizing:border-box}
:root{
  --white:#f4fbff;
  --soft:#d8f1ff;
  --cyan:#82eeff;
  --cyan2:#39a9ff;
  --blue1:#071632;
  --blue2:#14305e;
  --blue3:#0b57ca;
  --blue4:#3f9aff;
}
html,body{margin:0;height:100%;overflow:hidden;font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;color:var(--white)}
body{
  background:
    linear-gradient(rgba(4,13,35,.42),rgba(4,13,35,.58)),
    url('data:image/jpeg;base64,') center/cover no-repeat fixed;
}
.page{position:relative;width:100vw;height:100vh;padding:18px}
.page::before{content:"";position:absolute;inset:0;pointer-events:none;background:
  radial-gradient(circle at 18% 18%, rgba(111,210,255,.12), transparent 24%),
  radial-gradient(circle at 82% 16%, rgba(101,239,255,.12), transparent 22%),
  radial-gradient(circle at 60% 82%, rgba(73,120,255,.10), transparent 24%);
}
.shell{position:relative;z-index:1;width:min(97vw,1540px);height:min(93vh,900px);margin:0 auto;border-radius:30px;padding:14px 16px;background:linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02)),linear-gradient(180deg, rgba(14,31,76,.42), rgba(7,18,49,.50));border:1px solid rgba(255,255,255,.10);box-shadow:0 24px 70px rgba(0,0,0,.28), inset 0 0 0 1px rgba(255,255,255,.04);backdrop-filter:blur(6px);}
.poster{display:grid;grid-template-columns:58% 42%;height:100%;gap:10px;align-items:center}
.left-side{position:relative;height:100%;display:flex;align-items:center;justify-content:center;padding-left:8px}
.right-side{position:relative;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 18px 0 8px}
.wheel-wrap{position:relative;width:min(56vw,860px);aspect-ratio:1;display:flex;align-items:center;justify-content:center}
.aura{position:absolute;inset:8%;border-radius:50%;background:radial-gradient(circle, rgba(101,239,255,.24), rgba(47,124,255,.16) 45%, rgba(7,18,49,.04) 80%);filter:blur(35px)}
.outer-ornament{position:absolute;inset:3.7%;border-radius:50%;border:2px solid rgba(238,251,255,.92);box-shadow:0 0 0 3px rgba(151,223,255,.18),0 0 0 8px rgba(255,255,255,.035),0 0 28px rgba(101,239,255,.28),inset 0 0 24px rgba(255,255,255,.10)}
.outer-ornament::before,.outer-ornament::after{content:"";position:absolute;left:50%;transform:translateX(-50%);width:42px;height:42px;clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);background:linear-gradient(180deg,#ffffff,#8beeff 68%,#3faaff);border:1px solid rgba(255,255,255,.65);box-shadow:0 0 20px rgba(101,239,255,.65),0 0 0 4px rgba(255,255,255,.12)}
.outer-ornament::before{top:-23px}
.outer-ornament::after{bottom:-23px}
.side-gem{position:absolute;top:50%;width:34px;height:34px;transform:translateY(-50%) rotate(45deg);background:linear-gradient(180deg,#ffffff,#8beeff 68%,#3faaff);border:1px solid rgba(255,255,255,.65);box-shadow:0 0 20px rgba(101,239,255,.60),0 0 0 4px rgba(255,255,255,.12)}
.side-gem.left{left:1.8%} .side-gem.right{right:1.8%}
.wheel-wrap::before{content:"";position:absolute;inset:7.1%;border-radius:50%;border:1px dashed rgba(215,247,255,.34);box-shadow:0 0 14px rgba(101,239,255,.10);pointer-events:none;z-index:4}
.pointer{position:absolute;left:50%;top:5.2%;transform:translateX(-50%);z-index:25;width:0;height:0;border-left:22px solid transparent;border-right:22px solid transparent;border-top:40px solid #eefcff;filter:drop-shadow(0 6px 10px rgba(0,0,0,.28))}
.pointer::after{content:"";position:absolute;left:-8px;top:-36px;width:16px;height:16px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 5px rgba(255,255,255,.18),0 0 18px rgba(101,239,255,.55)}
.wheel{position:absolute;inset:9.5%;border-radius:50%;overflow:hidden;border:12px solid rgba(255,255,255,.18);box-shadow:0 24px 48px rgba(0,0,0,.24), inset 0 0 0 5px rgba(255,255,255,.05), inset 0 0 34px rgba(255,255,255,.10);transition:transform 5.4s cubic-bezier(.12,.77,.12,1);background:conic-gradient(from -22.5deg,#1f76ff 0 45deg,#0a56c9 45deg 90deg,#3a8dff 90deg 135deg,#0b62ea 135deg 180deg,#1f76ff 180deg 225deg,#0a56c9 225deg 270deg,#3a8dff 270deg 315deg,#0b62ea 315deg 360deg)}
.wheel::before{content:"";position:absolute;inset:0;border-radius:50%;background:repeating-conic-gradient(from -22.5deg, rgba(255,255,255,.84) 0 .72deg, transparent .72deg 45deg);-webkit-mask:radial-gradient(circle, transparent 0 15%, #000 15.5% 100%);mask:radial-gradient(circle, transparent 0 15%, #000 15.5% 100%);pointer-events:none}
.wheel::after{content:"";position:absolute;inset:12%;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(255,255,255,.14);pointer-events:none}
.center-ring{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:194px;height:194px;border-radius:50%;border:1px dashed rgba(255,255,255,.14);z-index:11;pointer-events:none}
.center-btn{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:162px;height:162px;border-radius:50%;border:9px solid rgba(255,255,255,.22);background:radial-gradient(circle at 35% 30%, #effdff 0%, #a1edff 38%, #31a7ff 100%);color:#08305f;font-size:29px;font-weight:900;letter-spacing:.05em;line-height:1.12;box-shadow:0 14px 24px rgba(0,0,0,.22), inset 0 0 18px rgba(255,255,255,.42), 0 0 32px rgba(101,239,255,.26);z-index:21;cursor:pointer}
.center-btn small{display:block;font-size:18px;margin-top:4px;font-weight:900}
.segment-label{position:absolute;left:50%;top:50%;width:148px;height:132px;transform-origin:center center;z-index:8;pointer-events:none;filter:drop-shadow(0 2px 10px rgba(0,0,0,.22))}
.segment-label .label-card{position:relative;width:148px;height:132px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;color:#f7fdff;background:transparent;border:0;box-shadow:none}
.segment-label .label-card.long{width:154px;height:136px}
.segment-label .label-card.short{width:142px;height:128px}
.segment-label .prize-icon{width:52px;height:52px;display:grid;place-items:center;font-size:28px;font-weight:900;color:#effdff;text-shadow:0 0 14px rgba(120,230,255,.72);filter:drop-shadow(0 0 9px rgba(101,239,255,.35))}
.segment-label .label-text{display:block;margin-top:7px;max-width:140px;text-align:center;word-break:keep-all;white-space:normal;font-size:17px;font-weight:900;line-height:1.14;letter-spacing:.02em;color:#f7fdff;text-shadow:0 2px 4px rgba(0,15,55,.72),0 0 14px rgba(120,220,255,.20)}
.segment-label .label-card.long .label-text{font-size:15px;max-width:146px}
.segment-label .label-card.short .label-text{font-size:18px;max-width:134px}
.right-inner{width:min(100%,540px);display:flex;flex-direction:column;align-items:center;gap:18px;position:relative}
.live-chip{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;background:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,.08));border:1px solid rgba(255,255,255,.14);font-size:14px;font-weight:800;color:#effcff;box-shadow:0 10px 18px rgba(0,0,0,.12)}
.live-chip .pulse{width:9px;height:9px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 5px rgba(101,239,255,.12),0 0 16px rgba(101,239,255,.45)}
.brand-script{position:relative;font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:clamp(38px,3.8vw,68px);font-weight:900;letter-spacing:.06em;color:#f7fdff;text-shadow:0 0 8px rgba(255,255,255,.55),0 0 20px rgba(101,239,255,.30),0 8px 20px rgba(0,0,0,.28);margin-bottom:-8px}
.brand-script::before,.brand-script::after{content:"✦";position:absolute;top:50%;transform:translateY(-50%);font-size:.34em;color:#dff8ff;opacity:.9;text-shadow:0 0 12px rgba(101,239,255,.55)}
.brand-script::before{left:-34px} .brand-script::after{right:-34px}
.big-title{position:relative;padding:14px 22px 8px;text-align:center;line-height:.95}
.big-title::before{content:"";position:absolute;left:50%;top:-4px;transform:translateX(-50%);width:76%;height:28px;border-top:1px solid rgba(225,248,255,.72);border-radius:50%;box-shadow:0 -4px 14px rgba(101,239,255,.18)}
.big-title::after{content:"◆";position:absolute;left:50%;top:-16px;transform:translateX(-50%);font-size:20px;color:#e8fbff;text-shadow:0 0 14px rgba(101,239,255,.6)}
.big-title .main{display:block;font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:clamp(54px,6vw,104px);font-weight:900;letter-spacing:.03em;background:linear-gradient(180deg,#ffffff 0%,#dff7ff 36%,#a8e6ff 70%,#effcff 100%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 22px rgba(106,236,255,.28),0 8px 16px rgba(0,0,0,.16)}
.big-title .sub{display:block;margin-top:14px;font-size:clamp(18px,1.4vw,26px);letter-spacing:.42em;color:#d7f1ff;text-shadow:0 0 14px rgba(101,239,255,.20)}
.glow-divider{width:72%;height:1px;position:relative;background:linear-gradient(90deg,transparent,rgba(230,250,255,.75),transparent);box-shadow:0 0 18px rgba(101,239,255,.18)}
.glow-divider::after{content:"◆";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#e8fbff;font-size:12px;text-shadow:0 0 12px rgba(101,239,255,.55)}
.info-plaque{position:relative;width:96%;padding:24px 26px 22px;border-radius:18px;background:linear-gradient(180deg,rgba(5,16,44,.74),rgba(5,16,44,.86)),radial-gradient(circle at 50% 0%,rgba(101,239,255,.12),transparent 42%);border:1px solid rgba(224,248,255,.60);outline:1px solid rgba(101,239,255,.12);outline-offset:4px;box-shadow:0 16px 34px rgba(0,0,0,.22),0 0 18px rgba(101,239,255,.10),inset 0 0 24px rgba(255,255,255,.035)}
.info-plaque::before,.info-plaque::after{content:"";position:absolute;top:50%;width:26px;height:26px;transform:translateY(-50%) rotate(45deg);background:linear-gradient(180deg,#ffffff,#82edff);border:1px solid rgba(255,255,255,.55);box-shadow:0 0 16px rgba(101,239,255,.40),0 0 0 3px rgba(255,255,255,.10)}
.info-plaque::before{left:-14px} .info-plaque::after{right:-14px}
.plaque-title{font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:clamp(30px,2.8vw,46px);letter-spacing:.16em;position:relative;padding-bottom:14px;text-align:center;color:#f5fdff;text-shadow:0 0 20px rgba(101,239,255,.22)}
.plaque-title::after{content:"◆  ✦  ◆";position:absolute;left:50%;bottom:-3px;transform:translateX(-50%);white-space:nowrap;font-size:11px;letter-spacing:.5em;color:#ccefff;text-shadow:0 0 12px rgba(101,239,255,.45)}
.plaque-sub{margin-top:16px;text-align:center;letter-spacing:.14em;color:#cfeaff}
.rule-box{margin-top:16px;border-radius:12px;padding:16px 18px;background:rgba(0,7,25,.36);border:1px solid rgba(226,249,255,.22);box-shadow:inset 0 0 16px rgba(101,239,255,.035)}
.rule-line{position:relative;padding:7px 0;font-size:18px;line-height:1.7;text-align:center;color:#eaf9ff;font-weight:700}
.rule-line strong{color:#fff}
.rule-line + .rule-line::before{content:"";position:absolute;left:18%;right:18%;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(220,247,255,.22),transparent)}
.mini-status{margin-top:16px;padding:12px 16px;border-radius:12px;background:rgba(255,255,255,.055);border:1px solid rgba(225,249,255,.16);font-size:15px;color:#dff4ff;text-align:center}
.footer{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);font-size:13px;color:#dcf2ff;opacity:.94;letter-spacing:.06em}
.modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(7,18,49,.52);backdrop-filter:blur(4px);z-index:100;padding:16px} .modal.show{display:flex}
.popup{width:min(92vw,440px);border-radius:24px;padding:26px 24px 20px;background:linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.04)),linear-gradient(180deg, rgba(17,42,101,.98), rgba(7,18,49,.98));box-shadow:0 26px 70px rgba(0,0,0,.32);text-align:center;color:#fffaff;position:relative;animation:pop .28s ease-out;border:1px solid rgba(255,255,255,.12)}
@keyframes pop{from{transform:scale(.9);opacity:.2}to{transform:scale(1);opacity:1}}
.popup .burst{font-size:38px;margin-bottom:8px} .popup h2{margin:0 0 8px;font-size:28px;font-weight:900;letter-spacing:.04em} .popup p{margin:0 0 18px;font-size:17px;color:#e2f3ff}
.popup .big-prize{display:inline-flex;align-items:center;justify-content:center;min-width:260px;min-height:60px;padding:12px 20px;border-radius:18px;background:linear-gradient(180deg, #eefcff, #8de9ff);box-shadow:inset 0 0 0 1px rgba(255,255,255,.62), 0 8px 20px rgba(0,0,0,.16);color:#08305f;font-size:25px;font-weight:900;margin-bottom:18px}
.popup .actions{display:flex;gap:12px;justify-content:center} .popup button{border:0;border-radius:999px;padding:12px 22px;font-size:15px;font-weight:800;cursor:pointer} .btn-primary{background:linear-gradient(180deg, #e9fdff, #78ebff);color:#0a3b67;box-shadow:0 8px 18px rgba(0,0,0,.14)} .btn-secondary{background:rgba(255,255,255,.10);color:#fff8ff}
@media (max-width:980px){body{overflow:auto} .page{height:auto;min-height:100vh} .shell{height:auto} .poster{grid-template-columns:1fr;gap:18px;padding-bottom:18px} .left-side{min-height:620px} .right-side{padding:0 6px 8px} .wheel-wrap{width:min(92vw,690px)} .footer{position:static;transform:none;text-align:center;margin-top:10px}}
@media (max-width:700px){.page{padding:10px} .shell{padding:10px;border-radius:22px} .wheel-wrap{width:min(96vw,560px)} .pointer{border-left-width:16px;border-right-width:16px;border-top-width:30px} .pointer::after{left:-5px;top:-27px;width:10px;height:10px;box-shadow:0 0 0 3px rgba(255,255,255,.22)} .segment-label{width:98px;height:94px} .segment-label .label-card{width:98px;height:94px} .segment-label .label-card.long{width:104px;height:98px} .segment-label .label-card.short{width:94px;height:90px} .segment-label .prize-icon{width:34px;height:34px;font-size:18px} .segment-label .label-text{margin-top:4px;font-size:11px;line-height:1.1;max-width:92px} .segment-label .label-card.long .label-text{font-size:10px;max-width:98px} .segment-label .label-card.short .label-text{font-size:12px;max-width:88px} .center-ring{width:146px;height:146px} .center-btn{width:118px;height:118px;font-size:22px;border-width:6px} .center-btn small{font-size:14px} .brand-script{font-size:32px} .brand-script::before{left:-20px} .brand-script::after{right:-20px} .big-title .main{font-size:48px} .big-title .sub{font-size:14px;letter-spacing:.22em} .info-plaque{width:100%;padding:18px 16px} .rule-line{font-size:15px}}
</style>
</head>
<body>
<div class="page">
  <div class="shell">
    <div class="poster">
      <div class="left-side">
        <div class="wheel-wrap">
          <div class="aura"></div>
          <div class="outer-ornament"></div>
          <div class="side-gem left"></div><div class="side-gem right"></div>
          <div class="pointer"></div>
          <div class="wheel" id="wheel"></div>
          <div class="center-ring"></div>
          <button class="center-btn" id="spinBtn">开启转盘<small>开始</small></button>
        </div>
      </div>
      <div class="right-side">
        <div class="right-inner">
          <div class="live-chip"><span class="pulse"></span>梦露 LIVE 投屏活动</div>
          <div class="brand-script">梦露</div>
          <div class="big-title"><span class="main">转盘活动</span><span class="sub">浪 漫 星 夜 ✦ 幸 运 开 启</span></div>
          <div class="glow-divider"></div>
          <div class="info-plaque">
            <div class="plaque-title">玩法介绍</div>
            <div class="plaque-sub">抽到什么内容，就按什么内容执行</div>
            <div class="rule-box">
              <div class="rule-line">首次轮盘：<strong>99</strong></div>
              <div class="rule-line">二次及以后：<strong>299</strong></div>
              <div class="rule-line">点击中间按钮即可开始抽奖</div>
            </div>
            <div class="mini-status" id="statusText">准备就绪，点击“开启转盘”开始今晚的幸运抽取</div>
          </div>
        </div>
      </div>
    </div>
    <div class="footer">梦露福利活动进行中</div>
  </div>
</div>
<div class="modal" id="modal">
  <div class="popup">
    <div class="burst">💙✨🌊</div><h2>恭喜抽中</h2><div class="big-prize" id="popupPrize">聆听半首歌</div><p id="popupText">梦露专属好运已送达，看看你抽中了什么福利吧。</p>
    <div class="actions"><button class="btn-secondary" id="closeModal">关闭</button><button class="btn-primary" id="againBtn">再转一次</button></div>
  </div>
</div>
<script>
(() => {
  const wheel = document.getElementById('wheel');
  const spinBtn = document.getElementById('spinBtn');
  const statusText = document.getElementById('statusText');
  const modal = document.getElementById('modal');
  const popupPrize = document.getElementById('popupPrize');
  const popupText = document.getElementById('popupText');
  const closeModal = document.getElementById('closeModal');
  const againBtn = document.getElementById('againBtn');
  const prizes = [
    { name:'古风点歌卡1张', weight:0.9, msg:'恭喜获得古风点歌卡1张，可以点一首古风歌曲。' },
    { name:'聆听半首歌', weight:15, msg:'恭喜获得聆听半首歌，可以享受半首专属演唱。' },
    { name:'流行点歌卡1张', weight:1, msg:'恭喜获得流行点歌卡1张，可以点一首流行歌曲。' },
    { name:'表白卡1张', weight:15, msg:'恭喜获得表白卡1张，可以指定一段表白内容。' },
    { name:'绕口令挑战', weight:10, msg:'恭喜抽中绕口令挑战，准备接受有趣挑战吧。' },
    { name:'朗读古诗词', weight:10, msg:'恭喜抽中朗读古诗词，请按规则进行朗读。' },
    { name:'小倒霉蛋', weight:22, msg:'这次抽中小倒霉蛋，别灰心，下一次说不定就是惊喜。' },
    { name:'重转一次', weight:25, msg:'好运加倍！你获得一次立即重转机会。' }
  ];
  const prettyNames = {
    '古风点歌卡1张':'古风点歌卡<br>1张',
    '聆听半首歌':'聆听<br>半首歌',
    '流行点歌卡1张':'流行点歌卡<br>1张',
    '表白卡1张':'表白卡<br>1张',
    '绕口令挑战':'绕口令<br>挑战',
    '朗读古诗词':'朗读<br>古诗词',
    '小倒霉蛋':'小倒霉蛋',
    '重转一次':'重转一次'
  };
  const icons = {
    '古风点歌卡1张':'♫',
    '聆听半首歌':'◈',
    '流行点歌卡1张':'♪',
    '表白卡1张':'♡',
    '绕口令挑战':'令',
    '朗读古诗词':'诗',
    '小倒霉蛋':'☁',
    '重转一次':'↻'
  };
  const totalWeight = prizes.reduce((sum,p)=>sum+p.weight,0);
  const radius = window.innerWidth <= 700 ? 132 : 198;

  prizes.forEach((item, i) => {
    const centerAngle = i * 45; // 每个奖品扇形正中间
    const label = document.createElement('div');
    label.className = 'segment-label';
    const len = item.name.length;
    const sizeClass = len >= 7 ? 'long' : (len <= 5 ? 'short' : '');
    label.innerHTML = `<div class="label-card ${sizeClass}"><span class="prize-icon">${icons[item.name] || '✦'}</span><span class="label-text">${prettyNames[item.name] || item.name}</span></div>`;
    label.style.transform = `translate(-50%, -50%) rotate(${centerAngle}deg) translateY(-${radius}px)`;
    wheel.appendChild(label);
  });

  let spinning = false;
  let currentRotation = 0;
  function secureRandom() { const arr = new Uint32Array(1); crypto.getRandomValues(arr); return arr[0] / 4294967296; }
  function pickWeightedIndex() { let r = secureRandom() * totalWeight; for (let i=0;i<prizes.length;i++) { r -= prizes[i].weight; if (r < 0) return i; } return prizes.length - 1; }
  function norm(deg) { return ((deg % 360) + 360) % 360; }
  let audioCtx = null;
  function ensureAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); if (audioCtx.state === 'suspended') audioCtx.resume(); }
  function playSpinSound() {
    ensureAudio(); const now = audioCtx.currentTime;
    const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
    osc.type = 'triangle'; osc.frequency.setValueAtTime(210, now); osc.frequency.exponentialRampToValueAtTime(620, now + 0.55);
    gain.gain.setValueAtTime(0.0001, now); gain.gain.exponentialRampToValueAtTime(0.035, now + 0.04); gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.58);
    osc.connect(gain).connect(audioCtx.destination); osc.start(now); osc.stop(now + 0.6);
    for (let i=0;i<12;i++) { const t = now + 0.12 + i * 0.12; const clickOsc = audioCtx.createOscillator(); const clickGain = audioCtx.createGain(); clickOsc.type='square'; clickOsc.frequency.setValueAtTime(980 - i * 34, t); clickGain.gain.setValueAtTime(0.0001, t); clickGain.gain.exponentialRampToValueAtTime(0.018, t + 0.003); clickGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.045); clickOsc.connect(clickGain).connect(audioCtx.destination); clickOsc.start(t); clickOsc.stop(t + 0.05); }
  }
  function playWinSound() {
    ensureAudio(); const now = audioCtx.currentTime;
    [659.25, 880, 1174.66].forEach((f, idx) => { const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain(); osc.type='sine'; osc.frequency.setValueAtTime(f, now + idx * 0.08); gain.gain.setValueAtTime(0.0001, now + idx * 0.08); gain.gain.exponentialRampToValueAtTime(0.05, now + idx * 0.08 + 0.02); gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.08 + 0.28); osc.connect(gain).connect(audioCtx.destination); osc.start(now + idx * 0.08); osc.stop(now + idx * 0.08 + 0.3); });
  }
  function showPopup(prize) { popupPrize.textContent = prize.name; popupText.textContent = prize.msg; modal.classList.add('show'); }
  function spin() {
    if (spinning) return;
    modal.classList.remove('show'); spinning = true; spinBtn.disabled = true; statusText.textContent = '转盘旋转中，请稍候…'; playSpinSound();
    const index = pickWeightedIndex(); const chosen = prizes[index];
    const targetCenter = index * 45; // 指针对准每个奖品扇形正中间
    const currentNorm = norm(currentRotation); const wantedNorm = norm(-targetCenter); const delta = norm(wantedNorm - currentNorm);
    const arr = new Uint32Array(1); crypto.getRandomValues(arr); const fullTurns = 6 + (arr[0] % 3);
    currentRotation += fullTurns * 360 + delta; wheel.style.transform = `rotate(${currentRotation}deg)`;
    setTimeout(() => { spinning = false; spinBtn.disabled = false; statusText.textContent = `恭喜抽中：${chosen.name}`; playWinSound(); showPopup(chosen); }, 5450);
  }
  spinBtn.addEventListener('click', spin); againBtn.addEventListener('click', spin); closeModal.addEventListener('click', () => modal.classList.remove('show')); modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('show'); });
})();
