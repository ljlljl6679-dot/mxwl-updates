<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>谁是卧底 · 投屏端</title>
<style>
*{box-sizing:border-box}html,body{height:100%;margin:0;font-family:"Microsoft YaHei","PingFang SC",sans-serif;color:white}
body{overflow:hidden;background:radial-gradient(circle at 18% 12%,rgba(239,110,232,.19),transparent 30%),radial-gradient(circle at 84% 18%,rgba(127,124,255,.22),transparent 32%),linear-gradient(135deg,#10051f,#28104b 58%,#4b1d76)}
.app{height:100%;padding:22px;display:flex;flex-direction:column;gap:15px}.top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.brand{display:flex;gap:12px;align-items:center}.logo{width:60px;height:60px;border-radius:18px;display:grid;place-items:center;font-size:34px;background:linear-gradient(135deg,#d88cff,#7e67ff)}.title{font-size:56px;font-weight:1000}.sub{font-size:13px;color:#cfc2e5}
.round{font-size:42px;font-weight:1000;padding:10px 22px;border-radius:18px;background:rgba(0,0,0,.18)}.status{text-align:right;color:#cfc2e5}.status b{display:block;color:white;font-size:26px}
.phase{padding:13px 18px;border-radius:20px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);text-align:center;font-size:22px;font-weight:900;color:#ead8ff}
.players{flex:1;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;overflow:auto}.card{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.12);border-radius:22px;padding:18px;display:flex;flex-direction:column;align-items:center;justify-content:center}.card.out{opacity:.38;filter:grayscale(.8)}.avatar{font-size:44px}.name{font-size:24px;font-weight:1000;margin-top:8px}.small{font-size:13px;color:#cfc2e5;margin-top:6px}.role{font-size:19px;color:#ead8ff;font-weight:900;margin-top:10px}
.footer{display:grid;grid-template-columns:1fr auto 1fr;gap:12px}.foot{padding:11px 14px;border-radius:16px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);font-size:14px}.center{text-align:center;font-size:18px}.right{text-align:right}
.overlay{position:fixed;inset:0;background:rgba(10,3,20,.88);display:none;align-items:center;justify-content:center;z-index:9;text-align:center}.overlay.show{display:flex}.result{padding:36px 48px;border-radius:28px;background:linear-gradient(145deg,rgba(101,52,151,.92),rgba(34,15,65,.95));border:1px solid rgba(255,255,255,.16)}.emoji{font-size:84px}.headline{font-size:48px;font-weight:1000}.answer{font-size:28px;color:#ead8ff;margin-top:16px;line-height:1.6}.answer b{color:#fff;font-size:34px}
.full{position:fixed;right:14px;bottom:14px;border:none;border-radius:999px;padding:10px 13px;background:rgba(0,0,0,.3);color:white;border:1px solid rgba(255,255,255,.15);cursor:pointer}
</style></head>
<body>
<div class="app">
<div class="top"><div class="brand"><div class="logo">🕵️</div><div><div class="title">谁是卧底</div><div class="sub">语音厅投屏端</div></div></div><div class="round">第 <span id="round">0</span> 轮</div><div class="status">当前阶段<b id="phase">准备中</b></div></div>
<div class="phase" id="phasebar">等待主持开始游戏</div>
<div class="players" id="players"><div class="card"><div class="avatar">🎙️</div><div class="name">等待玩家加入</div><div class="small">身份和词语不会在这里显示</div></div></div>
<div class="footer"><div class="foot">🎤 请依次描述自己的词语，不能直接说出答案</div><div class="foot center">存活：<b id="alive">0</b> 人</div><div class="foot right" id="log">等待开始</div></div>
</div>
<div class="overlay" id="overlay"><div class="result"><div class="emoji">🎭</div><div class="headline">本轮公布</div><div class="answer"><div>平民词：<b id="civilianReveal">—</b></div><div style="margin-top:10px">卧底词：<b id="undercoverReveal">—</b></div></div><div style="margin-top:18px;font-size:18px;color:#d8c8e9">卧底与平民身份已在玩家卡片中公开</div></div></div>
<button class="full" id="full">⛶ 全屏</button>
<script>
const $=id=>document.getElementById(id);
function esc(s){return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function render(s){$("round").textContent=s.round||0;$("phase").textContent=s.phase||"准备中";$("alive").textContent=s.alive||0;$("phasebar").textContent=s.revealed?"本局结束 · 身份已公布":s.started?"请依次描述词语并投票找出卧底":"等待主持开始游戏";
if(!s.players||!s.players.length){$("players").innerHTML='<div class="card"><div class="avatar">🎙️</div><div class="name">等待玩家加入</div><div class="small">身份和词语不会在这里显示</div></div>';return}
$("players").innerHTML=s.players.map(p=>`<div class="card ${p.out?'out':''}"><div class="avatar">${p.out?'🚫':'🎤'}</div><div class="name">${esc(p.name)}</div><div class="small">${p.out?'已淘汰':'游戏中'}</div>${s.revealed?`<div class="role">${p.publicRole==='卧底'?'🕵️ 卧底':'🙂 平民'}</div>`:''}</div>`).join("")}
window.addEventListener("message",e=>{let m=e.data;if(!m)return;if(["state","game-start","eliminate","next-round","reveal"].includes(m.type)){render(m);if(m.type==="game-start")$("log").textContent="游戏开始";if(m.type==="eliminate")$("log").textContent=(m.eliminated||"玩家")+" 已淘汰";if(m.type==="next-round")$("log").textContent="进入下一轮";if(m.type==="reveal"){$("log").textContent="身份与词语已公布";$("civilianReveal").textContent=m.civilianWord||"—";$("undercoverReveal").textContent=m.undercoverWord||"—";$("overlay").classList.add("show");setTimeout(()=>$("overlay").classList.remove("show"),5000)}}});
if(window.opener)window.opener.postMessage({type:"projector-ready"},"*");
$("full").onclick=async()=>{try{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();else await document.exitFullscreen()}catch(e){}};
</script>
</body></html>