<script>
(()=>{'use strict';
const KEY='voice-monopoly-yujianni-purple-v1';
const COLORS=['#ffcd70','#b4e2f2','#ffb9d5','#b5efa1','#d1befc','#ff9a77','#c1eeee','#f5eb9b'];
const legacyLabels=["GO","随机唱歪歌","前进两步","随机摇歪歌","老板给全麦糖","随机姐就是女王","再摇一次","2/7麦同唱歪歌","老板给全麦糖","增加两次摇","减少两次摇","随机卡路里","指定歌手自带歪歌","4麦六口茶","前进三步","全麦给8麦糖","随机非主流歌","随机青藏高原","老板给全麦糖","后退一步","1麦不正经唱歌","3麦随机歪歌","回到起点","随机土嗨歌曲","5麦方言唱歌","半价全麦歌单一次","减少两次摇","老板给全麦糖","接待红烧肉","指定首字随机歌手","随机歌手阳光彩虹小白马","随机歌手偶买噶噶","随机六口茶","8麦指定歌手唱歌","全麦歌手爆灯嗨一分钟","半价公爵卡","随机加速歌单","随机高音歌","山路十八弯","随机麦位冠名一天","随机学猫叫","后退四步","随机歌手彩虹糖的梦","老板给全麦糖","老板指定歌手唱歌","指定麦位冠名一天","回到起点","停留一轮","随机嘴巴嘟嘟","全麦歌手爆灯嗨一分钟","3/5麦同唱歪歌","后退三步","随机猪猪侠","随机大家一起喜羊羊","接待唱土鸡蛋","随机高音歌","随机小幸运","老板送奶茶","后退四步","全麦来个大合唱","随机点唱挑战","通关"];
const baseLabels=["GO","当前歌手·歪歌","前进两步","当前歌手·摇歪歌","老板全麦送糖","当前歌手·女王挑战","再摇一次","2/7麦·歪歌合唱","老板全麦送糖","增加两次摇","减少两次摇","当前歌手·卡路里","指定歌手·歪歌","4麦·六口茶","前进三步","全麦送8麦糖","当前歌手·非主流","当前歌手·青藏高原","老板全麦送糖","后退一步","1麦·反差唱法","3麦+当前歌手·歪歌","回到起点","当前歌手·土嗨","5麦·方言挑战","全麦歌单半价","减少两次摇","老板全麦送糖","接待·红烧肉","当前歌手·首字挑战","当前歌手·阳光彩虹小白马","当前歌手·偶买噶","当前歌手·六口茶","8麦·指定唱歌","全麦·爆灯1分钟","公爵卡半价","当前歌手·加速歌单","当前歌手·高音挑战","当前歌手·山路十八弯","当前歌手·冠名一天","当前歌手·学猫叫","后退四步","当前歌手·彩虹糖的梦","老板全麦送糖","老板指定歌手点歌","指定麦位·冠名一天","回到起点","停留一轮","当前歌手·嘴巴嘟嘟","全麦·爆灯1分钟","3/5麦·歪歌合唱","后退三步","当前歌手·猪猪侠","当前歌手·喜羊羊","接待·土鸡蛋","当前歌手·高音挑战","当前歌手·小幸运","老板请全麦奶茶","后退四步","全麦·合唱挑战","当前歌手·点唱挑战","荣耀通关"];
const coordinates=[];
for(let y=4;y<=10;y++)coordinates.push([10,y]);
for(let x=9;x>=0;x--)coordinates.push([x,10]);
for(let y=9;y>=0;y--)coordinates.push([0,y]);
for(let x=1;x<=10;x++)coordinates.push([x,0]);
for(let y=1;y<=3;y++)coordinates.push([10,y]);
for(let x=8;x>=2;x--)coordinates.push([x,3]);
for(let y=4;y<=8;y++)coordinates.push([2,y]);
for(let x=3;x<=8;x++)coordinates.push([x,8]);
for(let y=7;y>=4;y--)coordinates.push([8,y]);
if(coordinates.length!==baseLabels.length)throw Error('棋盘数量不一致 '+coordinates.length);
const legacyRules='全麦 1000 钻摇 6 次 · 接待 1200 钻\n全麦 2100 钻摇 15 次 · 接待 2100 钻\n全麦 6600 钻摇豪档 · 接待 4000 钻';
const previousRules='单人1688钻摇6次\n全麦1000钻一人5次\n全麦3000钻 豪玩1小时';
const defaultRules='单人1888钻摇六次\n全麦1288钻一人5次\n全麦3000钻豪玩一小时';
const makePlayers=()=>['1麦','2麦','3麦','4麦'].map((name,i)=>({id:i+1,name,color:COLORS[i],pos:0,rolls:0,skips:0,extra:0,completed:false}));
const defaults=()=>({players:makePlayers(),turnIndex:0,labels:[...baseLabels],singers:'1麦、2麦、3麦、4麦、5麦、6麦、7麦、8麦、接待',title:'屿见你 · 自走棋',rules:defaultRules,currentSinger:'',sound:true,history:[],lastDie:1,idSeq:5});
let state=defaults(),undoStack=[],rolling=false,editMode=false,currentModal=null,audio=null;
try{const old=JSON.parse(localStorage.getItem(KEY));if(old&&Array.isArray(old.labels)&&old.labels.length===62&&Array.isArray(old.players)&&old.players.length){state={...defaults(),...old};if(!old.rules||old.rules===legacyRules||old.rules===previousRules)state.rules=defaultRules;state.labels=old.labels.map((s,i)=>typeof s==='string'?(s===legacyLabels[i]?baseLabels[i]:normalizeSingerLabel(s)):baseLabels[i]);state.players=old.players.slice(0,8).map((p,i)=>({...makePlayers()[0],...p,color:p.color||COLORS[i%8],pos:Math.max(0,Math.min(61,Number(p.pos)||0))}));state.turnIndex=Math.min(Math.max(0,state.turnIndex),state.players.length-1);}}catch(e){}
function normalizeSingerLabel(label){return String(label).replace(/随机歌手/g,'当前歌手').replace(/随机麦位/g,'当前歌手').replace(/随机/g,'当前歌手').replace(/当前歌手当前歌手/g,'当前歌手');}
const $=id=>document.getElementById(id);
const DIE_SYMBOLS=['','⚀','⚁','⚂','⚃','⚄','⚅'];
let animatedPlayerId=null,animatedFace=1;
const escapeHTML=s=>String(s).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
function save(){try{localStorage.setItem(KEY,JSON.stringify(state));}catch(e){}}
function snapshot(){undoStack.push(JSON.stringify(state));if(undoStack.length>15)undoStack.shift();}
