function setDie(value){$('dice').querySelectorAll('.pip').forEach((e,i)=>e.classList.toggle('on',({1:[4],2:[0,8],3:[0,4,8],4:[0,2,6,8],5:[0,2,4,6,8],6:[0,2,3,5,6,8]})[value].includes(i)));state.lastDie=value;}
function sound(type='click'){
 if(!state.sound)return;
 try{const AudioContext=window.AudioContext||window.webkitAudioContext;if(!AudioContext)return;if(!audio)audio=new AudioContext();if(audio.state==='suspended')audio.resume();
 let tones=type==='win'?[523,659,784,1046]:type==='roll'?[440,520]:type==='step'?[400]:[620];tones.forEach((hz,i)=>{const o=audio.createOscillator(),g=audio.createGain();o.type=type==='step'?'triangle':'sine';o.frequency.value=hz;o.connect(g);g.connect(audio.destination);const t=audio.currentTime+i*.115;g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(type==='step'?.045:.075,t+.012);g.gain.exponentialRampToValueAtTime(.0001,t+.095);o.start(t);o.stop(t+.105);});}catch(e){}
}
function coordinatesPoint(i){const [x,y]=coordinates[i],unit=86.18;return[26+unit*x+42,26+unit*y+42];}
function coordinatesPercent(i){const [x,y]=coordinates[i],unit=86.18;return[(26+unit*x+43.09)/10,(26+unit*y+43.09)/10];}
function clearPath(){const cells=$('board').querySelectorAll('.cell');cells.forEach(c=>c.classList.remove('path'));}
function showWalker(player,index,face){const walker=$('walker');if(!walker)return;animatedFace=face||animatedFace||1;walker.style.setProperty('--walker-color',player&&player.color?player.color:'#ffcd70');walker.querySelector('.walker-face').textContent=DIE_SYMBOLS[animatedFace]||'⚀';const tagNum=Math.max(1,state.players.findIndex(pp=>player&&pp.id===player.id)+1);walker.querySelector('.walker-tag').textContent=String(tagNum);const [left,top]=coordinatesPercent(index);walker.style.left=left+'%';walker.style.top=top+'%';walker.classList.remove('hidden');walker.classList.remove('bounce');void walker.offsetWidth;walker.classList.add('bounce');}
function hideWalker(){const walker=$('walker');if(walker)walker.classList.add('hidden');}
function flashScreen(kind){const el=$('screenFlash');if(!el)return;el.classList.remove('show','win');if(kind==='win')el.classList.add('win');void el.offsetWidth;el.classList.add('show');setTimeout(()=>el.classList.remove('show','win'),700);}
function impactAt(index,win){const board=$('board');if(!board)return;const [left,top]=coordinatesPercent(index);const ring=document.createElement('span');ring.className='impact-ring';ring.style.left=left+'%';ring.style.top=top+'%';const burst=document.createElement('span');burst.className='impact-burst'+(win?' win':'');burst.style.left=left+'%';burst.style.top=top+'%';board.append(ring,burst);setTimeout(()=>{ring.remove();burst.remove();},900);}
function makeDecor(){for(let i=0;i<75;i++){const el=document.createElement('span');el.className='spark';el.style.left=((i*37.13+13)%100)+'%';el.style.top=((i*61.21+5)%100)+'%';const s=i%7===0?4:i%3===0?2:1;el.style.width=s+'px';el.style.height=s+'px';$('sky').appendChild(el);}const svg=$('track');const points=coordinates.map((_,i)=>coordinatesPoint(i).join(',')).join(' ');svg.innerHTML='<polyline points="'+points+'" />';}
function tileType(label,index){if(index===0)return'start';if(index===61||label.includes('通关'))return'finish';if(/前进|后退|回到起点/.test(label))return'motion';if(/再摇|增加|减少|停留/.test(label))return'special';return'task-cell';}
function drawBoard(){const board=$('board');board.querySelectorAll('.cell').forEach(c=>c.remove());state.labels.forEach((label,i)=>{const [x,y]=coordinates[i],unit=86.18;let cell=document.createElement('div');cell.className='cell '+tileType(label,i)+(label.length>13?' extra-long':label.length>9?' long':'')+(editMode?' edit-mode':'');cell.style.left=(26+unit*x)/10+'%';cell.style.top=(26+unit*y)/10+'%';cell.dataset.index=i;cell.title='第'+i+'格：'+label+(editMode?'（点击编辑）':'');const small=document.createElement('span');small.className='cell-number';small.textContent=i===0?'★':i===61?'★':String(i).padStart(2,'0');const content=document.createElement('span');content.className='cell-text';content.textContent=label;const tokens=document.createElement('div');tokens.className='tokens';cell.append(small,content,tokens);cell.addEventListener('click',()=>{if(rolling)return;if(editMode)editTile(i);else showTileTip(i);});board.appendChild(cell);});drawTokens();}
function drawTokens(){const els=$('board').querySelectorAll('.cell');els.forEach(e=>{e.classList.remove('highlight');e.querySelector('.tokens').replaceChildren();});const live=state.players[state.turnIndex];state.players.forEach((p,i)=>{if(animatedPlayerId&&p.id===animatedPlayerId)return;const cell=els[p.pos];if(!cell)return;const icon=document.createElement('span');icon.className='token'+(p.id===live?.id?' current':'');icon.style.background=p.color;icon.textContent=String(i+1);icon.title=p.name;cell.querySelector('.tokens').appendChild(icon);});if(live&&els[live.pos])els[live.pos].classList.add('highlight');}
function render(){const curr=state.players[state.turnIndex];$('heading').textContent=state.title;$('rulesText').textContent=state.rules;$('centerTurn').textContent=curr?'✦ 轮到 '+curr.name+' · 第 '+(curr.pos+1)+' 格 ✦':'✦ 游戏结束 ✦';$('turnName').textContent=curr?.name||'没有玩家';$('turnPos').textContent=curr?`${curr.completed?'已通关 · ':'距离终点 '+(61-curr.pos)+' 格 · '}已摇 ${curr.rolls} 次${curr.extra?' · 加摇 '+curr.extra+' 次':''}`:'';$('turnInitial').textContent=curr?state.turnIndex+1:'—';$('turnInitial').style.background=curr?.color||'#8a6738';$('turnInitial').style.color='#181316';$('playerCount').textContent=`${state.players.length} / 8`;const pl=$('players');pl.replaceChildren();state.players.forEach((p,i)=>{const el=document.createElement('div');el.className='player'+(i===state.turnIndex?' active-player':'');const label=p.completed?'🏆 已通关':p.skips?' · 暂停 '+p.skips+' 轮':'';el.innerHTML=`<div class="player-dot" style="background:${p.color}">${i+1}</div><div class="player-info"><div class="player-top"><span class="player-name" title="${escapeHTML(p.name)}">${escapeHTML(p.name)}</span>${i===state.turnIndex?'<span style="color:#dfb66e;font-size:10px">▶ 当前</span>':''}</div><div class="player-meta">第 ${p.pos} 步 / ${p.rolls} 次${label}</div><div class="player-bar"><span style="width:${p.pos/61*100}%"></span></div></div><button type="button" class="tiny-action" aria-label="修改玩家" title="修改玩家">✎</button>`;el.querySelector('button').addEventListener('click',()=>editPlayer(p.id));pl.appendChild(el)});const h=$('history');h.replaceChildren();if(state.history.length===0){h.innerHTML='<div class="empty">摇动骰子，精彩故事从这里开始 ✦</div>';}else{state.history.slice(0,20).forEach(entry=>{const item=document.createElement('div');item.className='history-item';item.innerHTML='<b>'+escapeHTML(entry.name)+'</b> · '+escapeHTML(entry.text);h.appendChild(item);});}$('soundBtn').textContent=state.sound?'♪ 音效开启':'♪ 音效关闭';$('soundBtn').classList.toggle('active',state.sound);$('editBtn').classList.toggle('active',editMode);$('editBtn').textContent=editMode?'✓ 完成编辑':'✎ 编辑格子';$('rollBtn').disabled=rolling||!curr||curr.completed;$('nextBtn').disabled=rolling||state.players.length<=1;$('undoBtn').disabled=rolling||undoStack.length===0;setDie(state.lastDie||1);drawTokens();save();}
function history(name,text){state.history.unshift({name,text});state.history=state.history.slice(0,20);}
function showModal(html,action){currentModal=action||'info';$('modalContents').innerHTML=html;const overlay=$('overlay');overlay.classList.add('show');overlay.classList.toggle('result-mode',action==='result');$('modalX').style.display=action==='result'?'none':'block';}
function closeModal(){currentModal=null;const overlay=$('overlay');overlay.classList.remove('show','result-mode');}
function modalBase(icon,title,desc,buttons){return `<div class="modal-kicker">✦ LUCKY EVENT ✦</div><div class="modal-icon">${icon}</div><div class="modal-title" id="modalTitle">${escapeHTML(title)}</div><div class="modal-desc">${escapeHTML(desc)}</div><div class="modal-buttons">${buttons||'<button class="modal-confirm" id="closeInfo">我知道了</button>'}</div>`;}
function showTileTip(index){if(index===0||index===61)return;showModal(modalBase('✦','第 '+index+' 格',state.labels[index]+'\n点击「编辑格子」可以自定义这一格的任务。'));$('closeInfo').onclick=closeModal;}
function buttonAction(){const extra=state.players[state.turnIndex]?.extra>0;return `<button id="resultNext" class="modal-confirm">${extra?'✨ 加摇一次':'✓ 完成 · 下一位'}</button><button id="resultStay" class="modal-secondary">继续当前玩家</button>`;}
function finishModal(player,die,index,events){let label=state.labels[index],isFinish=player.completed;let detail=`🎲 摇出 ${die} 点 · 到达第 ${index} 格`;
 if(events.length)detail+='\n'+events.join('\n');
 if(!events.length)detail+='\n请按上方内容完成趣味任务';
 if(label.includes('当前歌手'))detail+='\n🎤 执行人：'+(state.currentSinger||'当前歌手');
 if(isFinish){detail+='\n恭喜完成全部棋盘挑战！';sound('win');celebrate();}
 history(player.name,`掷出 ${die} → ${label}`);
 render();flashScreen(isFinish?'win':'task');impactAt(index,isFinish);
 showModal(modalBase(isFinish?'🏆':(tileType(label,index)==='motion'?'✨':'🎙'),isFinish?'恭喜通关！':label,detail,buttonAction()),'result');
 $('resultNext').onclick=()=>{snapshot();closeModal();advanceTurn();};$('resultStay').onclick=()=>{closeModal();render();};}
async function animateMove(p,from,to,face){const distance=Math.abs(to-from),dir=to>=from?1:-1;animatedPlayerId=p.id;animatedFace=face||state.lastDie||animatedFace||1;clearPath();showWalker(p,from,animatedFace);drawTokens();await wait(180);for(let n=0;n<distance;n++){const next=from+(n+1)*dir;p.pos=next;drawTokens();const cells=$('board').querySelectorAll('.cell');if(cells[next])cells[next].classList.add('path');showWalker(p,next,animatedFace);sound('step');await wait(distance>10?105:230);}await wait(160);animatedPlayerId=null;hideWalker();render();}
function relativeMotion(label){if(label.includes('回到起点'))return'reset';const match=label.match(/(前进|后退)([一二三四五六七八九十\d]+)步/);if(!match)return null;const ch=match[2],cn={'一':1,'二':2,'三':3,'四':4,'五':5,'六':6,'七':7,'八':8,'九':9,'十':10};const value=Number(ch)||cn[ch]||0;return(match[1]==='前进'?1:-1)*value;}
async function applyLanding(p,die){const log=[];let chained=0;while(chained++<4){const label=state.labels[p.pos];if(p.pos===61||label==='通关'){p.completed=true;log.push('🏆 抵达终点，成功通关');break;}const step=relativeMotion(label);if(step==='reset'){log.push('↩ 回到起点');p.pos=0;drawTokens();break;}if(typeof step==='number'&&step!==0){const prev=p.pos,next=Math.max(0,Math.min(61,prev+step));log.push((step>0?'➜ 前进 ':'↩ 后退 ')+Math.abs(step)+' 步');if(next===prev)break;await animateMove(p,prev,next);continue;}
 if(/再摇一次/.test(label)){p.extra++;log.push('🎁 获得额外掷骰 1 次');}
 else if(/增加两次摇/.test(label)){p.extra+=2;log.push('🎁 获得额外掷骰 2 次');}
 else if(/减少两次摇/.test(label)){p.skips+=2;log.push('⏸ 之后跳过 2 个回合');}
 else if(/停留/.test(label)){p.skips++;log.push('⏸ 下一轮暂停 1 次');}
 break;}
 return log;}
async function roll(){if(rolling||$('overlay').classList.contains('show'))return;const p=state.players[state.turnIndex];if(!p||p.completed)return;snapshot();rolling=true;$('rollBtn').disabled=true;$('nextBtn').disabled=true;$('rollBtn').textContent='骰子转动中…';sound('roll');const face=$('dice'),board=$('board');board.classList.add('rolling-phase');face.classList.add('rolling');const spin=setInterval(()=>setDie(1+Math.floor(Math.random()*6)),65);await wait(980);clearInterval(spin);const die=1+Math.floor(Math.random()*6);setDie(die);face.classList.remove('rolling');sound('click');const from=p.pos,to=Math.min(61,from+die);p.rolls++;await animateMove(p,from,to,die);const events=await applyLanding(p,die);board.classList.remove('rolling-phase');rolling=false;$('rollBtn').textContent='🎲 开始摇骰';finishModal(p,die,p.pos,events);}
function advanceTurn(){const cur=state.players[state.turnIndex];if(!cur)return;if(cur.extra&&!cur.completed){cur.extra--;history(cur.name,'获得额外一次掷骰机会');render();return;}if(state.players.every(p=>p.completed)){history('系统','所有玩家均已通关');render();showModal(modalBase('🏆','全员通关','恭喜所有玩家完成挑战！可以点击「重开本局」再开一局。'));$('closeInfo').onclick=closeModal;return;}
 let next=state.turnIndex;let found=false;for(let i=0;i<state.players.length;i++){next=(next+1)%state.players.length;const p=state.players[next];if(p.completed)continue;if(p.skips>0){p.skips--;history(p.name,'因暂停效果跳过一次掷骰');continue;}found=true;break;}
 if(!found){const unfinished=state.players.findIndex(p=>!p.completed);if(unfinished>=0)next=unfinished;}
 state.turnIndex=next;render();}
function nextTurn(){if(rolling||$('overlay').classList.contains('show'))return;snapshot();const cur=state.players[state.turnIndex];if(cur)cur.extra=0;advanceTurn();}
function undo(){if(rolling||$('overlay').classList.contains('show')||!undoStack.length)return;state=JSON.parse(undoStack.pop());drawBoard();render();sound();}
function editTile(i){const val=state.labels[i];showModal(`<div class="modal-kicker">EDIT BOARD TILE</div><div class="edit-heading" id="modalTitle">✎ 编辑第 ${i} 格任务</div><div class="field"><label for="tileInput">任务文案</label><textarea id="tileInput" maxlength="44" rows="3">${escapeHTML(val)}</textarea><div class="field-tip">特殊玩法可使用关键词：前进两步、后退三步、回到起点、再摇一次、增加两次摇、减少两次摇、停留一轮；其他文案按任务卡执行。</div></div><div class="modal-buttons"><button class="modal-secondary" id="cancelEdit">取消</button><button class="modal-confirm" id="saveTile">保存格子</button></div>`,'edit');$('cancelEdit').onclick=closeModal;$('saveTile').onclick=()=>{const text=$('tileInput').value.trim();if(!text)return alert('任务不能为空');snapshot();state.labels[i]=text;closeModal();drawBoard();render();};}
// 从 JSON 文件导入 / 导出棋盘配置；仅影响配置，不修改玩家和骰子记录。
function buildConfig(){return {app:'屿见你自走棋',formatVersion:1,exportedAt:new Date().toISOString(),config:{labels:[...state.labels],title:state.title,rules:state.rules,currentSinger:state.currentSinger||''}};}
function exportConfig(){if(rolling)return;const body=JSON.stringify(buildConfig(),null,2);const blob=new Blob([body],{type:'application/json;charset=utf-8'});const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download='屿见你自走棋_配置备份_'+new Date().toLocaleDateString('sv-SE')+'.json';document.body.appendChild(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),5000);sound('click');}
function parseBackup(data){if(!data||typeof data!=='object'||Array.isArray(data)||data.app!=='屿见你自走棋'||data.formatVersion!==1||!data.config||typeof data.config!=='object')throw Error('这不是本游戏导出的配置文件。');const obj=data.config;if(!Array.isArray(obj.labels)||obj.labels.length!==62||!obj.labels.every(x=>typeof x==='string'&&x.trim().length>0&&x.length<=120))throw Error('备份文件的 62 格任务数据不完整。');if(typeof obj.title!=='string'||!obj.title.trim()||obj.title.length>80||typeof obj.rules!=='string'||obj.rules.length>1000||typeof obj.currentSinger!=='string'||obj.currentSinger.length>80)throw Error('备份文件的标题、玩法介绍或歌手内容不正确。');return {labels:obj.labels.map(x=>x.trim()),title:obj.title.trim().slice(0,24),rules:obj.rules.trim(),currentSinger:obj.currentSinger.trim().slice(0,30)};}
function applyConfig(config){snapshot();state.labels=[...config.labels];state.title=config.title;state.rules=config.rules;state.currentSinger=config.currentSinger;editMode=false;closeModal();drawBoard();render();sound('click');}
function confirmRestoreDefaults(){if(rolling)return;showModal(modalBase('↶','恢复默认配置','将把 62 格任务、棋盘标题、玩法介绍和当前歌手恢复到《屿见你 自走棋》的默认内容。\n玩家位置、掷骰次数和本局记录不受影响。\n建议先点击「导出配置」备份当前修改。',`<button class="modal-secondary" id="cancelRestore">取消</button><button class="modal-confirm" id="confirmRestore">确认恢复默认</button>`),'restore');$('cancelRestore').onclick=settings;$('confirmRestore').onclick=()=>{applyConfig({labels:baseLabels,title:defaults().title,rules:defaultRules,currentSinger:''});};}
$('configImportInput').addEventListener('change',async e=>{if(rolling)return;const file=e.target.files&&e.target.files[0];if(!file)return;e.target.value='';if(file.size>250000){alert('配置文件超过 250KB，请确认选择正确的 JSON 文件。');return;}try{const parsed=JSON.parse(await file.text());const cfg=parseBackup(parsed);showModal(modalBase('⬆','导入棋盘配置','文件：'+file.name+'\n将用备份中的 62 格任务、标题、玩法介绍和当前歌手覆盖本地配置。\n当前玩家位置和掷骰记录会保留。',`<button class="modal-secondary" id="cancelImport">取消</button><button class="modal-confirm" id="confirmImport">确认导入</button>`),'import');$('cancelImport').onclick=settings;$('confirmImport').onclick=()=>applyConfig(cfg);}catch(err){alert('无法导入配置：'+(err&&err.message?err.message:'文件格式错误'));}});
function settings(){showModal(`<div class="modal-kicker">GAME SETTINGS</div><div class="edit-heading" id="modalTitle">⚙ 游戏设置</div><div class="field"><label for="titleInput">活动 / 棋盘标题</label><input id="titleInput" maxlength="24" value="${escapeHTML(state.title)}"></div><div class="field"><label for="currentSingerInput">当前歌手名称（选填）</label><input id="currentSingerInput" maxlength="30" placeholder="不填则显示「当前歌手」" value="${escapeHTML(state.currentSinger||'')}"><div class="field-tip">任务中的「当前歌手」指当前演唱的歌手，不再抽取其他歌手。这里可填入其名字。</div></div><div class="field"><label for="ruleInput">棋盘中央规则文案</label><textarea id="ruleInput" rows="3">${escapeHTML(state.rules)}</textarea></div><section class="backup-panel"><div class="backup-title">💾 棋盘配置备份</div><p class="backup-note">可备份 62 格任务、活动名称、玩法介绍和当前歌手。先保存设置，再导出；导入与恢复默认不影响玩家位置和本局进度。</p><div class="backup-actions"><button type="button" id="exportConfigBtn">⬇ 导出配置</button><button type="button" id="importConfigBtn">⬆ 导入配置</button><button type="button" class="danger-restore" id="restoreDefaultBtn">↶ 恢复默认</button></div></section><div class="modal-buttons"><button class="modal-secondary" id="cancelSettings">取消</button><button class="modal-confirm" id="saveSettings">保存设置</button></div>`,'settings');$('exportConfigBtn').onclick=exportConfig;$('importConfigBtn').onclick=()=>{$('configImportInput').value='';$('configImportInput').click();};$('restoreDefaultBtn').onclick=confirmRestoreDefaults;$('cancelSettings').onclick=closeModal;$('saveSettings').onclick=()=>{const title=$('titleInput').value.trim();if(!title)return alert('活动标题不可为空');snapshot();state.title=title;state.currentSinger=$('currentSingerInput').value.trim();state.rules=$('ruleInput').value.trim();closeModal();render();};}
function editPlayer(id){const idx=state.players.findIndex(p=>p.id===id);if(idx<0)return;const p=state.players[idx];showModal(`<div class="modal-kicker">EDIT PLAYER</div><div class="edit-heading" id="modalTitle">♟ 玩家信息</div><div class="field"><label for="editPlayerName">玩家 / 老板名称</label><input id="editPlayerName" maxlength="12" value="${escapeHTML(p.name)}"></div><div class="field"><label for="editPosition">棋子位置（0 到 61）</label><input id="editPosition" type="number" min="0" max="61" value="${p.pos}"></div><div class="modal-buttons"><button class="modal-secondary" id="deletePlayer">移除玩家</button><button class="modal-confirm" id="savePlayer">保存修改</button></div>`,'player');$('savePlayer').onclick=()=>{const name=$('editPlayerName').value.trim();const pos=Math.round(Number($('editPosition').value));if(!name||!Number.isFinite(pos)||pos<0||pos>61)return alert('请填写有效名称和 0-61 的位置');snapshot();p.name=name;p.pos=pos;p.completed=pos===61;closeModal();render();};$('deletePlayer').onclick=()=>{if(state.players.length===1)return alert('至少保留一位玩家');snapshot();state.players.splice(idx,1);if(state.turnIndex>=state.players.length)state.turnIndex=0;else if(idx<state.turnIndex)state.turnIndex--;closeModal();render();};}
function addPlayer(){if(rolling)return;if(state.players.length>=8)return alert('最多支持 8 位玩家');const name=$('newPlayer').value.trim();if(!name)return $('newPlayer').focus();snapshot();const id=state.idSeq++;state.players.push({id,name,color:COLORS[(state.players.length)%COLORS.length],pos:0,rolls:0,skips:0,extra:0,completed:false});$('newPlayer').value='';history('系统','玩家「'+name+'」加入游戏');render();}
function reset(){if(rolling)return;showModal(modalBase('↻','重新开局','会清空本局所有玩家位置、掷骰次数和事件记录。\n已编辑的棋盘任务、歌手池与活动标题会保留。',`<button class="modal-secondary" id="cancelReset">取消</button><button class="modal-confirm" id="confirmReset">确认重新开始</button>`),'reset');$('cancelReset').onclick=closeModal;$('confirmReset').onclick=()=>{snapshot();state.players.forEach(p=>Object.assign(p,{pos:0,rolls:0,skips:0,extra:0,completed:false}));state.turnIndex=0;state.history=[];state.lastDie=1;closeModal();render();};}
function help(){showModal(modalBase('🎲','屿见你 · 游戏玩法','【参与档位】\n单人1888钻摇六次\n全麦1288钻一人5次\n全麦3000钻豪玩一小时\n\n【游戏方式】\n① 点击「开始摇骰」，掷出1–6点。紫色骰子沿棋盘逐格行走。\n② 落到哪一格，就完成该格任务；「当前歌手」即本轮演唱的歌手，不会额外抽人。\n③ 前进、后退、加摇、暂停等特殊格自动生效。\n④ 主持人点击「完成 · 下一位」，也可继续当前玩家。\n⑤ 支持编辑62格任务、修改当前歌手名称以及查看记录。\n⑥ 游戏设置内可导出、导入配置备份，或恢复默认任务。'));$('closeInfo').onclick=closeModal;}
function celebrate(){const colors=['#ffffff','#f0e2ff','#d8b5ff','#b97eff','#8d58ea','#ceb2ff'];for(let i=0;i<60;i++){const c=document.createElement('span');c.className='confetti';c.style.left=Math.random()*100+'%';c.style.background=colors[i%colors.length];c.style.setProperty('--drift',(Math.random()*500-250)+'px');c.style.setProperty('--dur',(2+Math.random()*2.4)+'s');c.style.animationDelay=(Math.random()*.65)+'s';document.body.append(c);setTimeout(()=>c.remove(),5500);}}
$('rollBtn').onclick=roll;$('nextBtn').onclick=nextTurn;$('undoBtn').onclick=undo;$('settingBtn').onclick=settings;$('helpBtn').onclick=help;$('resetBtn').onclick=reset;$('addBtn').onclick=addPlayer;$('newPlayer').onkeydown=e=>{if(e.key==='Enter')addPlayer();};$('editBtn').onclick=()=>{if(rolling)return;editMode=!editMode;drawBoard();render();};$('soundBtn').onclick=()=>{state.sound=!state.sound;render();if(state.sound)sound('click');};$('fullBtn').onclick=async()=>{try{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();else await document.exitFullscreen();}catch(e){alert('当前浏览器不支持自动进入全屏，可按 F11 进入全屏。');}};
$('modalX').onclick=()=>{if(currentModal!=='result')closeModal();};$('overlay').addEventListener('click',e=>{if(e.target===$('overlay')&&currentModal!=='result')closeModal();});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&currentModal!=='result')closeModal();if(e.code==='Space'&&!(e.target instanceof HTMLInputElement)&&!(e.target instanceof HTMLTextAreaElement)&&!e.repeat){e.preventDefault();if(!$('overlay').classList.contains('show'))roll();}});
makeDecor();drawBoard();render();
})();
</script>
