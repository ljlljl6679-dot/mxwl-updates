@echo off
chcp 65001 >nul
setlocal EnableExtensions
cd /d "%~dp0"
echo Enter the full path of the folder generated by the ADMIN publisher, containing manifest.json and files\
set /p "SOURCE=Folder path: "
set "SOURCE=%SOURCE:"=%"
if not exist "%SOURCE%\manifest.json" (
 echo [ERROR] Cannot find manifest.json in chosen folder.
 pause
 exit /b 1
)
if not exist "%SOURCE%\files\" (
 echo [ERROR] Cannot find files folder.
 pause
 exit /b 1
)
if not exist "files\" mkdir "files"
xcopy "%SOURCE%\files\*" "files\" /S /E /I /Y >nul
if errorlevel 2 (
 echo [ERROR] File copy failed.
 pause
 exit /b 1
)
copy /Y "%SOURCE%\manifest.json" "manifest.json" >nul
if errorlevel 1 (
 echo [ERROR] Manifest copy failed.
 pause
 exit /b 1
)
call "%~dp0一键上传到GitHub.bat"
